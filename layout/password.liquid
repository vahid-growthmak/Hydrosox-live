<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    <link rel="canonical" href="{{ canonical_url }}">
    {{ 'hs-base.css' | asset_url | stylesheet_tag }}
    {% render 'hs-tokens' %}
    {{ content_for_header }}
  </head>
  <body class="hs-body">
    <main id="hs-main" role="main">{{ content_for_layout }}</main>
  </body>
</html>
