<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.logo -%}
      <link rel="icon" type="image/png" href="{{ settings.logo | image_url: width: 48 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%}
      Pages that exist for shoppers but should not compete in search: paginated
      pages beyond the first, tag indexes, search results, the cart and account.
      All of them are near-duplicates of a page that is indexed, or hold nothing
      worth ranking, so leaving them open splits the ranking signal.

      Collections are held back by handle from a theme setting. Note that
      `collection.tags` in Liquid lists the tags of the products inside the
      collection, not tags on the collection itself, so it cannot be used to
      mark one — a product tagged "seo-noindex" would have de-indexed the whole
      collection.
    {%- endcomment -%}
    {%- liquid
      assign noindex = false
      if current_page != 1 or current_tags or request.path contains '/search'
        assign noindex = true
      endif
      if request.path contains '/cart' or request.path contains '/account'
        assign noindex = true
      endif
      if collection.handle != blank
        assign held = settings.noindex_collections | default: '' | replace: ' ', '' | split: ','
        if held contains collection.handle
          assign noindex = true
        endif
      endif
    -%}
    {%- if noindex -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {% render 'hs-meta-social' %}

    {{ 'hs-base.css' | asset_url | stylesheet_tag }}
    {{ 'hs-chrome.css' | asset_url | stylesheet_tag }}
    {{ 'hs-home.css' | asset_url | stylesheet_tag }}
    {{ 'hs-pages.css' | asset_url | stylesheet_tag }}

    {% render 'hs-tokens' %}

    {{ content_for_header }}
  </head>

  <body
    class="hs-page template-{{ template.name | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}"
  >
    <a class="hs-skip" href="#hs-main">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="hs-main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%}
      The cart drawer lives in the layout, not in a page template, because it
      has to exist wherever an add-to-cart button does. On the cart page itself
      it is redundant, and the merchant may have chosen the page anyway, so
      neither case renders it.
    {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <script src="{{ 'hs-reveal.js' | asset_url }}" defer></script>
  </body>
</html>
