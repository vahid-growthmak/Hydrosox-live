{%- comment -%}
  Shop by activity.

  A bento of bordered cards on a four-column grid. Each activity block chooses
  its own footprint: featured (two columns and two rows, the image filling the
  card), standard (a 16:9 image over the text), or a horizontal wide or full
  row (image beside the text). Defaults reproduce the designed arrangement —
  one featured card, two standard, one wide, one full-width.
{%- endcomment -%}

{%- liquid
  assign activities = section.blocks | where: 'type', 'activity'
  assign activity_count = activities | size
-%}

<section
  class="hs-activity hs-scheme-{{ section.settings.color_scheme }} hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-loose">
    {% render 'hs-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      lede: section.settings.lede,
      heading_measure: 'hs-activity__measure',
      lede_size: 'caption',
      lede_measure: 'hs-measure-32',
      lede_tone: 'faint'
    %}

    {%- if activity_count > 0 -%}
      <ul class="hs-activity__grid hs-stagger" role="list">
        {%- for block in activities -%}
          {%- liquid
            assign size = block.settings.size | default: 'standard'
            assign title_class = 'hs-h4'
            if size == 'featured'
              assign title_class = 'hs-h3'
            endif
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
            assign card_tag = 'div'
            if has_link
              assign card_tag = 'a'
            endif
          -%}
          <li class="hs-activity__item hs-activity__item--{{ size }}" {{ block.shopify_attributes }}>
            <{{ card_tag }}
              class="hs-reveal hs-activity__card hs-activity__card--{{ size }}"
              {% if has_link %}
                href="{{ block.settings.link }}"
              {% endif %}
            >
              <span class="hs-activity__media-frame">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1080 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 480 }} 480w,
                      {{ block.settings.image | image_url: width: 828 }} 828w,
                      {{ block.settings.image | image_url: width: 1080 }} 1080w,
                      {{ block.settings.image | image_url: width: 1600 }} 1600w
                    "
                    sizes="(min-width: 64rem) 45vw, (min-width: 40rem) 90vw, 100vw"
                    alt="{{ block.settings.image_alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    decoding="async"
                    class="hs-activity__img"
                  >
                {%- elsif block.settings.image_fallback != blank -%}
                  {%- comment -%}
                    Intrinsic size of the bundled activity photography. The frame
                    is sized by CSS; these only stop the browser guessing.
                  {%- endcomment -%}
                  <img
                    src="{{ block.settings.image_fallback | asset_url }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    width="1672"
                    height="941"
                    loading="lazy"
                    decoding="async"
                    class="hs-activity__img"
                  >
                {%- endif -%}
              </span>

              <span class="hs-activity__body">
                <span class="hs-activity__head-row">
                  <span class="hs-activity__head-main">
                    {% render 'hs-index-number',
                      index: forloop.index0,
                      size: 'label',
                      class: 'hs-activity__index hs-faint'
                    %}
                    {%- if block.settings.title != blank -%}
                      <span class="{{ title_class }} hs-activity__title">{{ block.settings.title }}</span>
                    {%- endif -%}
                  </span>
                  {%- if has_link -%}
                    {% render 'hs-icon', icon: 'arrow-up-right', size: 20, class: 'hs-activity__arrow' %}
                  {%- endif -%}
                </span>
                {%- if block.settings.problem != blank -%}
                  <span class="hs-small-body hs-activity__problem hs-measure-42 hs-pretty hs-muted">
                    {{- block.settings.problem -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.meta != blank -%}
                  <span class="hs-eyebrow hs-activity__meta hs-faint">{{ block.settings.meta }}</span>
                {%- endif -%}
              </span>
            </{{ card_tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="hs-small-body hs-activity__footnote hs-pretty hs-muted">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.activity.name",
  "class": "hs-activity-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "ink", "label": "t:common.scheme_ink" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" }
      ],
      "default": "ink"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "activity"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Shop by activity"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Find the version of wet feet you actually have."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>One sock. Five different problems it solves, described the way the people with those problems describe them.</p>"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "t:sections.activity.footnote",
      "default": "Same sock either way — the activity only changes which pair you reach for."
    }
  ],
  "blocks": [
    {
      "type": "activity",
      "name": "t:sections.activity.block_activity",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.activity.size",
          "info": "t:sections.activity.size_info",
          "options": [
            { "value": "featured", "label": "t:sections.activity.size_featured" },
            { "value": "standard", "label": "t:sections.activity.size_standard" },
            { "value": "wide", "label": "t:sections.activity.size_wide" },
            { "value": "full", "label": "t:sections.activity.size_full" }
          ],
          "default": "standard"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:common.title",
          "default": "Hiking"
        },
        {
          "type": "textarea",
          "id": "problem",
          "label": "t:sections.activity.problem",
          "info": "t:sections.activity.problem_info"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "t:sections.activity.meta"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:common.link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:common.image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:common.image_alt"
        },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "t:sections.activity.image_fallback",
          "info": "t:sections.film.poster_fallback_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.activity.name",
      "blocks": [
        {
          "type": "activity",
          "settings": {
            "size": "featured",
            "title": "Hiking",
            "problem": "Boots that wet out four hours into a long day in the hills.",
            "meta": "Long days, wet ground",
            "image_fallback": "activity-hiking.webp",
            "image_alt": "A walker stopped on a rocky mountain path in white HydroSox."
          }
        },
        {
          "type": "activity",
          "settings": {
            "size": "standard",
            "title": "Walking",
            "problem": "Wet grass at eight in the morning, in shoes that were never waterproof.",
            "meta": "Everyday miles, all year",
            "image_fallback": "activity-walking.webp",
            "image_alt": "A walker mid-stride on a tree-lined park path in white HydroSox."
          }
        },
        {
          "type": "activity",
          "settings": {
            "size": "standard",
            "title": "All Day in Boots",
            "problem": "Boots that keep the rain out and then seal the sweat in.",
            "meta": "Long shifts, five days a week",
            "image_fallback": "activity-all-day-in-boots.webp",
            "image_alt": "Brown leather lace-up boots on a city pavement, worn with HydroSox."
          }
        },
        {
          "type": "activity",
          "settings": {
            "size": "wide",
            "title": "Cycling & Commuting",
            "problem": "Overshoes that leak at the ankle, and shoes still wet at home time.",
            "meta": "No drying option at the other end",
            "image_fallback": "activity-cycling-and-commuting.webp",
            "image_alt": "A commuter riding across a city bridge in white HydroSox."
          }
        },
        {
          "type": "activity",
          "settings": {
            "size": "full",
            "title": "Running & Trail",
            "problem": "Cold, soaked feet on winter miles, and blisters in a wet race.",
            "meta": "Weight and bulk, stated honestly",
            "image_fallback": "activity-running-and-trail.webp",
            "image_alt": "A runner mid-stride on a stony mountain trail in white HydroSox."
          }
        }
      ]
    }
  ]
}
{% endschema %}
