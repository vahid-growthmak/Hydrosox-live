{%- comment -%}
  Buy widget.

  Bound to a real product: colours and sizes are read from the product's own
  options, and the blocks only supply presentation (a swatch colour, a UK shoe
  range). If the merchant renames an option value in Shopify, the widget still
  renders it — the block simply stops decorating it.

  Quantity tiers state a discount per tier rather than a finished price, so the
  figure shown here is the same number configured on the matching automatic
  discount and the two cannot drift apart.
{%- endcomment -%}

{%- liquid
  assign product = all_products[section.settings.product]
  assign has_product = false
  if product != blank and product.id
    assign has_product = true
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign unit_price = current_variant.price | default: product.price | default: 0

  # Locate the colour and size options by the names the merchant gave them.
  # Compared case-insensitively, so "Colour" and "colour" both match.
  assign colour_option_index = 0
  assign size_option_index = 0
  assign wanted_colour = section.settings.colour_option_name | downcase | strip
  assign wanted_size = section.settings.size_option_name | downcase | strip

  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == wanted_colour
      assign colour_option_index = forloop.index
    endif
    if option_name == wanted_size
      assign size_option_index = forloop.index
    endif
  endfor

  # Zero-based positions, since a filter cannot be used inside a subscript.
  assign colour_i = colour_option_index | minus: 1
  assign size_i = size_option_index | minus: 1
  assign colour_option = product.options_with_values[colour_i]
  assign size_option = product.options_with_values[size_i]
-%}

<section
  class="hs-buy hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-buy__pad">
    {%- comment -%} Heading {%- endcomment -%}
    {%- liquid
      # On the product template this widget carries the page's H1, and the H1 is
      # the plain product name from Shopify — the one page where a literal
      # heading outperforms a written one, because it confirms exactly what the
      # shopping-intent visitor searched for. Everywhere else the widget keeps
      # its own heading as an h2.
      assign buy_heading = section.settings.heading
      assign buy_heading_tag = 'h2'
      if template.name == 'product' and product != blank
        assign buy_heading = product.title
        assign buy_heading_tag = 'h1'
      endif
    -%}
    <div class="hs-buy__head">
      {% render 'hs-section-head',
        eyebrow: section.settings.eyebrow,
        heading: buy_heading,
        heading_tag: buy_heading_tag,
        lede: section.settings.lede,
        heading_size: 'h3',
        heading_measure: 'hs-measure-22',
        lede_measure: 'hs-measure-40'
      %}
    </div>

    <div class="hs-buy__body">
      {%- comment -%} Product image {%- endcomment -%}
      <div class="hs-buy__gallery">
        <div class="hs-buy__gallery-sticky" data-hs-gallery>
          {%- liquid
            # The selected variant's own photograph, so the colour on screen is
            # the colour being bought. Falls back to the product's featured
            # image where a variant has none, and a merchant-chosen image in the
            # theme editor still overrides both.
            #
            # Rendered server-side as well as swapped by script: the first paint
            # is then already the right colourway, and the widget stays correct
            # if the script never runs.
            assign gallery_image = section.settings.image
            if gallery_image == blank and has_product
              assign gallery_image = current_variant.image | default: product.featured_image
            endif

            assign gallery_alt = section.settings.image_alt
            if gallery_image.alt != blank
              assign gallery_alt = gallery_image.alt
            endif
          -%}
          {% render 'hs-image',
            image: gallery_image,
            fallback: 'hydrosox-colourways.jpg',
            alt: gallery_alt,
            aspect: '4 / 5',
            sizes: '(min-width: 64rem) 38vw, 100vw',
            wrapper_class: 'hs-buy__media'
          %}
        </div>
      </div>

      {%- comment -%} Form {%- endcomment -%}
      <div class="hs-buy__form-col">
        {%- if has_product -%}
          <hs-buy
            data-product-url="{{ product.url }}"
            data-colour-index="{{ colour_option_index }}"
            data-size-index="{{ size_option_index }}"
            data-money-format="{{ shop.money_format | escape }}"
            data-unit-price="{{ unit_price }}"
            data-label-save="{{ section.settings.save_label | escape }}"
            data-label-per-unit="{{ section.settings.per_unit_label | escape }}"
            data-label-against="{{ 'products.product.against' | t: amount: '__AMOUNT__' | escape }}"
            data-label-unavailable="{{ 'products.product.unavailable_variant' | t | escape }}"
            data-label-sold-out="{{ 'products.product.sold_out' | t | escape }}"
            data-label-add="{{ section.settings.add_label | escape }}"
          >
            {%- comment -%} Variant data for the client, straight from the product. {%- endcomment -%}
            <script type="application/json" data-hs-variants>
              [
                {%- for variant in product.variants -%}
                  {%- liquid
                    # Each variant carries its own photograph, so selecting a
                    # colour can change the picture. src and srcset are built
                    # here rather than in script: only Liquid can call
                    # image_url, and hand-assembling Shopify CDN parameters in
                    # JavaScript is the kind of thing that breaks silently when
                    # the CDN changes.
                    assign v_image = variant.image | default: product.featured_image
                    assign v_alt = v_image.alt
                    if v_alt == blank
                      assign v_alt = product.title | append: ' in ' | append: variant.title
                    endif

                    # Built through named assigns rather than one pipe chain:
                    # `append` cannot take an image object, so chaining
                    # image_url through it silently produces a broken srcset.
                    assign v_480 = v_image | image_url: width: 480
                    assign v_720 = v_image | image_url: width: 720
                    assign v_1080 = v_image | image_url: width: 1080
                    assign v_1440 = v_image | image_url: width: 1440
                    assign v_srcset = v_480 | append: ' 480w, ' | append: v_720 | append: ' 720w, ' | append: v_1080 | append: ' 1080w, ' | append: v_1440 | append: ' 1440w'
                  -%}
                  {
                    "id": {{ variant.id }},
                    "available": {{ variant.available }},
                    "price": {{ variant.price }},
                    "options": {{ variant.options | json }},
                    "title": {{ variant.title | json }}
                    {%- if v_image != blank -%}
                      ,
                      "image": {{ v_1080 | json }},
                      "srcset": {{ v_srcset | json }},
                      "alt": {{ v_alt | json }}
                    {%- endif -%}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            </script>

            {% form 'product', product, id: 'hs-buy-form', class: 'hs-buy__form', novalidate: 'novalidate' %}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-hs-variant-id>
              <input type="hidden" name="quantity" value="{{ section.settings.default_quantity | default: 1 }}" data-hs-quantity>

              {%- comment -%} Colour {%- endcomment -%}
              {%- if colour_option_index > 0 -%}
                <fieldset class="hs-buy__fieldset">
                  <legend class="hs-eyebrow hs-buy__legend">{{ colour_option.name }}</legend>
                  <div class="hs-buy__swatches" role="radiogroup" aria-label="{{ colour_option.name | escape }}">
                    {%- for value in colour_option.values -%}
                      {%- liquid
                        assign swatch_one = ''
                        assign swatch_two = ''
                        for block in section.blocks
                          if block.type == 'colour' and block.settings.value == value
                            assign swatch_one = block.settings.colour_one
                            assign swatch_two = block.settings.colour_two
                            break
                          endif
                        endfor
                        assign is_selected = false
                        if current_variant.options[colour_i] == value
                          assign is_selected = true
                        endif
                      -%}
                      <button
                        type="button"
                        class="hs-buy__swatch{% if is_selected %} is-selected{% endif %}"
                        role="radio"
                        aria-checked="{{ is_selected }}"
                        data-hs-option="colour"
                        data-hs-value="{{ value | escape }}"
                      >
                        <span class="hs-buy__swatch-ring">
                          <span
                            class="hs-buy__swatch-dot"
                            {% if swatch_two != blank %}
                              style="background: linear-gradient(90deg, {{ swatch_one }} 0 50%, {{ swatch_two }} 50% 100%);"
                            {% elsif swatch_one != blank %}
                              style="background-color: {{ swatch_one }};"
                            {% endif %}
                          ></span>
                        </span>
                        <span class="hs-caption hs-buy__swatch-label hs-balance">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endif -%}

              {%- comment -%} Size {%- endcomment -%}
              {%- if size_option_index > 0 -%}
                <fieldset class="hs-buy__fieldset hs-buy__fieldset--ruled">
                  <div class="hs-buy__legend-row">
                    <legend class="hs-eyebrow hs-buy__legend">{{ size_option.name }}</legend>
                    {%- if section.settings.guide_label != blank -%}
                      <button class="hs-tap hs-caption hs-buy__guide-open" type="button" data-hs-guide-open>
                        {{ section.settings.guide_label }}
                      </button>
                    {%- endif -%}
                  </div>
                  <div class="hs-buy__sizes" role="radiogroup" aria-label="{{ size_option.name | escape }}">
                    {%- for value in size_option.values -%}
                      {%- liquid
                        assign sublabel = ''
                        for block in section.blocks
                          if block.type == 'size' and block.settings.value == value
                            assign sublabel = block.settings.sublabel
                            break
                          endif
                        endfor
                        assign is_selected = false
                        if current_variant.options[size_i] == value
                          assign is_selected = true
                        endif
                      -%}
                      <button
                        type="button"
                        class="hs-buy__size{% if is_selected %} is-selected{% endif %}"
                        role="radio"
                        aria-checked="{{ is_selected }}"
                        data-hs-option="size"
                        data-hs-value="{{ value | escape }}"
                      >
                        <span class="hs-small-body hs-buy__size-name">{{ value }}</span>
                        {%- if sublabel != blank -%}
                          <span class="hs-caption hs-tnum hs-buy__size-sub">{{ sublabel }}</span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endif -%}

              {%- comment -%} Quantity tiers {%- endcomment -%}
              {%- liquid
                assign tier_count = 0
                for block in section.blocks
                  if block.type == 'tier'
                    assign tier_count = tier_count | plus: 1
                  endif
                endfor
              -%}
              {%- if tier_count > 0 -%}
                <fieldset class="hs-buy__fieldset hs-buy__fieldset--ruled">
                  <legend class="hs-eyebrow hs-buy__legend">{{ section.settings.quantity_label }}</legend>
                  <div class="hs-buy__tiers" role="radiogroup" aria-label="{{ section.settings.quantity_label | escape }}">
                    {%- assign tier_i = 0 -%}
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'tier' -%}
                        {%- liquid
                          assign tier_i = tier_i | plus: 1
                          assign qty = block.settings.quantity | at_least: 1
                          # Pence, as an integer. This was pounds with a
                          # decimal until the theme editor rounded every tier
                          # on save — Shopify coerces a number setting, so
                          # 3.01 became 3.0 and nine templates showed £37.00
                          # for a bundle that checkout charges £36.99 for.
                          # An integer survives the round trip.
                          assign discount_cents = block.settings.discount_pence | default: 0
                          assign gross = unit_price | times: qty
                          assign net = gross | minus: discount_cents
                          assign per_unit = net | divided_by: qty
                          assign is_default = false
                          if block.settings.quantity == section.settings.default_quantity
                            assign is_default = true
                          endif

                          # Price transparency. The DMCCA 2024 requires an
                          # invitation to purchase to show the total price
                          # including every mandatory charge, and the CMA has
                          # confirmed that delivery is mandatory where the
                          # customer cannot get the goods without paying it —
                          # there is no collection option here — and that
                          # showing the parts without summing them is not
                          # enough. So any tier that does not reach the
                          # free-delivery threshold prints its own grand total.
                          #
                          # Both numbers are settings: the charge belongs to
                          # this section, the threshold is the same global one
                          # the cart progress bar reads, so the widget and the
                          # cart cannot disagree about where delivery becomes
                          # free.
                          assign delivery_cents = section.settings.delivery_charge_pence | default: 0
                          # Pairs, not money — the same rule the cart bar uses
                          # and the same one the announcement bar promises.
                          # Measured against the old £35 money threshold this
                          # happened to give the right answer for these tiers,
                          # but only by coincidence: the two-pair price is
                          # £36.99, so a £36 threshold would have quietly made
                          # a single pair qualify.
                          assign free_from_items = settings.free_delivery_min_items | plus: 0
                          assign tier_total = net | plus: delivery_cents
                          assign tier_pays_delivery = false
                          if delivery_cents > 0 and free_from_items > 0 and qty < free_from_items
                            assign tier_pays_delivery = true
                          endif
                        -%}
                        <button
                          type="button"
                          class="hs-buy__tier{% if is_default %} is-selected{% endif %}"
                          role="radio"
                          aria-checked="{{ is_default }}"
                          data-hs-tier
                          data-hs-qty="{{ qty }}"
                          data-hs-discount="{{ discount_cents }}"
                          {{ block.shopify_attributes }}
                        >
                          <span class="hs-buy__tier-mark" aria-hidden="true">
                            {% render 'hs-icon', icon: 'check', size: 12, class: 'hs-buy__tier-check' %}
                          </span>
                          <span class="hs-buy__tier-main">
                            {%- comment -%}
                              The exclusive-offer flag on the single pair —
                              free delivery on one pair is a limited promotion
                              and the tier says so, since a shopper comparing
                              rungs would otherwise assume it is the standing
                              rule. Keyed on quantity 1 rather than on a block
                              setting so the ladder can be re-ordered without
                              the badge wandering.
                            {%- endcomment -%}
                            {%- if qty == 1 and section.settings.offer_label != blank -%}
                              <span class="hs-eyebrow hs-buy__tier-flag hs-buy__tier-flag--offer">{{ section.settings.offer_label }}</span>
                            {%- endif -%}
                            {%- if is_default and section.settings.recommend_label != blank -%}
                              {%- comment -%}
                                The recommendation rides on whichever tier is
                                the default, so the two can never point at
                                different rungs of the ladder.
                              {%- endcomment -%}
                              <span class="hs-eyebrow hs-buy__tier-flag">{{ section.settings.recommend_label }}</span>
                            {%- endif -%}
                            <span class="hs-small-body hs-buy__tier-label">{{ block.settings.label }}</span>
                            {%- if discount_cents > 0 -%}
                              <span class="hs-caption hs-tnum hs-buy__tier-save">
                                {{ section.settings.save_label }} {{ discount_cents | money }}
                              </span>
                            {%- endif -%}
                          </span>
                          <span class="hs-buy__tier-price hs-tnum">
                            <span class="hs-small-body hs-buy__tier-total">{{ net | money }}</span>
                            {%- comment -%}
                              Each clause is its own span so the caption wraps
                              between them on a narrow screen rather than
                              splitting a figure from its word.
                            {%- endcomment -%}
                            {%- if tier_pays_delivery -%}
                              <span class="hs-caption hs-buy__tier-unit">
                                <span class="hs-buy__tier-part">
                                  {{- '+' }} {{ delivery_cents | money }} {{ section.settings.delivery_label -}}
                                </span>
                                <span class="hs-buy__tier-part">
                                  &middot; {{ tier_total | money }} {{ section.settings.total_label -}}
                                </span>
                              </span>
                            {%- elsif qty > 1 -%}
                              <span class="hs-caption hs-buy__tier-unit">
                                <span class="hs-buy__tier-part">
                                  {{- per_unit | money }} {{ section.settings.per_unit_label -}}
                                </span>
                              </span>
                            {%- endif -%}
                          </span>
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- comment -%}
                    The v4 content sets one sentence directly under the
                    ladder — why most people buy two — which had no slot
                    until now. Renders nothing while the setting is empty.
                  {%- endcomment -%}
                  {%- if section.settings.ladder_note != blank -%}
                    <p class="hs-caption hs-buy__ladder-note hs-pretty hs-muted">
                      {{- section.settings.ladder_note -}}
                    </p>
                  {%- endif -%}
                </fieldset>
              {%- endif -%}

              {%- comment -%} Add to cart {%- endcomment -%}
              <button
                class="hs-buy__submit hs-small-body"
                type="submit"
                name="add"
                data-hs-submit
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span data-hs-submit-label>
                  {%- if current_variant.available -%}
                    {{ section.settings.add_label }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                <span class="hs-buy__submit-rule" aria-hidden="true"></span>
                <span class="hs-tnum" data-hs-submit-total></span>
              </button>

              <p class="hs-caption hs-tnum hs-buy__savings" data-hs-savings aria-live="polite"></p>
            {% endform %}
          </hs-buy>
        {%- else -%}
          {%- comment -%}
            No product chosen yet. Say so in the editor rather than rendering a
            widget that cannot add anything to a cart.
          {%- endcomment -%}
          <div class="hs-buy__empty">
            <p class="hs-small-body">{{ 'products.product.unavailable' | t }}</p>
            <p class="hs-caption hs-muted">{{ section.settings.empty_help }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} Trust rows {%- endcomment -%}
        {%- liquid
          assign trust_count = 0
          for block in section.blocks
            if block.type == 'trust'
              assign trust_count = trust_count | plus: 1
            endif
          endfor
        -%}
        {%- if trust_count > 0 -%}
          <dl class="hs-buy__trust">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust' -%}
                <div class="hs-buy__trust-row" {{ block.shopify_attributes }}>
                  <dt class="hs-eyebrow hs-muted">{{ block.settings.label }}</dt>
                  <dd class="hs-caption hs-buy__trust-value">{{ block.settings.value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- comment -%} Detail links {%- endcomment -%}
        {%- liquid
          assign link_count = 0
          for block in section.blocks
            if block.type == 'link'
              assign link_count = link_count | plus: 1
            endif
          endfor
        -%}
        {%- if link_count > 0 -%}
          <div class="hs-buy__links">
            {%- for block in section.blocks -%}
              {%- if block.type == 'link' -%}
                {%- liquid
                  assign link_url = block.settings.link
                  if link_url == blank and block.settings.use_product_url and has_product
                    assign link_url = product.url
                  endif
                -%}
                <a
                  class="hs-tap hs-small-body hs-buy__detail-link"
                  href="{{ link_url | default: '#' }}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.label -}}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Size guide, in a native dialog {%- endcomment -%}
  {%- liquid
    assign guide_rows = 0
    for block in section.blocks
      if block.type == 'guide_row'
        assign guide_rows = guide_rows | plus: 1
      endif
    endfor
  -%}
  {%- if guide_rows > 0 -%}
    <dialog class="hs-guide" data-hs-guide aria-labelledby="hs-guide-title-{{ section.id }}">
      <div class="hs-guide__inner">
        <h3 class="hs-h4" id="hs-guide-title-{{ section.id }}">{{ section.settings.guide_heading }}</h3>
        {%- if section.settings.guide_intro != blank -%}
          <p class="hs-caption hs-guide__intro hs-muted">{{ section.settings.guide_intro }}</p>
        {%- endif -%}

        <table class="hs-caption hs-guide__table">
          <thead>
            <tr>
              <th class="hs-eyebrow hs-muted" scope="col">{{ section.settings.guide_col_size }}</th>
              <th class="hs-eyebrow hs-muted" scope="col">{{ section.settings.guide_col_length }}</th>
              <th class="hs-eyebrow hs-muted hs-guide__cell--end" scope="col">
                {{ section.settings.guide_col_shoe }}
              </th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'guide_row' -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="hs-guide__cell--name">{{ block.settings.size }}</td>
                  <td class="hs-tnum">{{ block.settings.foot_length }}</td>
                  <td class="hs-tnum hs-guide__cell--end hs-muted">{{ block.settings.uk_shoe }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>

        {%- liquid
          assign note_count = 0
          for block in section.blocks
            if block.type == 'guide_note'
              assign note_count = note_count | plus: 1
            endif
          endfor
        -%}
        {%- if note_count > 0 -%}
          <div class="hs-guide__notes">
            {%- for block in section.blocks -%}
              {%- if block.type == 'guide_note' -%}
                <div {{ block.shopify_attributes }}>
                  <p class="hs-eyebrow hs-muted">{{ block.settings.label }}</p>
                  <p class="hs-caption hs-guide__note-body hs-pretty">{{ block.settings.body }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Both parts required. Falling back to '#' turned a missing URL into
          a link that scrolled the page under the open overlay to the top and
          left the overlay sitting there — which is exactly what it did on
          every template, since none of them set the URL.
        {%- endcomment -%}
        {%- if section.settings.guide_link_label != blank and section.settings.guide_link_url != blank -%}
          <a class="hs-tap hs-caption hs-guide__link" href="{{ section.settings.guide_link_url }}">
            {{- section.settings.guide_link_label -}}
          </a>
        {%- endif -%}

        <button class="hs-caption hs-guide__close" type="button" data-hs-guide-close>
          {{ section.settings.guide_close_label }}
        </button>
      </div>
    </dialog>
  {%- endif -%}
</section>

<script src="{{ 'hs-buy.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.buy.name",
  "class": "hs-buy-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:common.product",
      "info": "t:sections.buy.product_info"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "paper"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "buy"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Two decisions and a quantity."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>One product, one page, one price that does not change depending on how you found us.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:common.image",
      "info": "t:sections.buy.image_info"
    },
    {
