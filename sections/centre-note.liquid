{%- comment -%}
  Centre note — a single centred statement.

  Used where a page has to say one plain thing without a list or an image
  competing with it: the limits band on an activity page, a scope caveat, a
  short policy statement.
{%- endcomment -%}

<section
  class="hs-note hs-scheme-{{ section.settings.color_scheme }}{% unless section.settings.hide_rule %} hs-border-b{% endunless %} hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-{{ section.settings.pace | default: 'base' }}">
    <div class="hs-note__inner" style="--hs-note-max: {{ section.settings.max_width }}rem;">
      {% render 'hs-eyebrow',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading
      %}
      {%- if section.settings.heading != blank -%}
        {%- liquid
          # A page that opens with this section owns the h1; one used as a band
          # inside a longer page stays an h2.
          assign heading_tag = section.settings.heading_tag | default: 'h2'
          assign heading_size = section.settings.heading_size | default: 'h3'
        -%}
        <{{ heading_tag }} class="hs-{{ heading_size }} hs-note__heading hs-balance">
          {{- section.settings.heading -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        {%- comment -%}
          `lead_first_para` sets the opening paragraph a step larger, so a
          definition reads as a definition rather than as the first line of body
          copy. Used where the first paragraph is written to stand on its own —
          both a featured snippet and an LLM lift the opening paragraph, and the
          type size is the cheapest way to signal that it is self-contained.
        {%- endcomment -%}
        <div
          class="hs-body hs-note__body hs-measure-58 hs-pretty hs-muted{% if section.settings.lead_first_para %} hs-note__body--lead{% endif %}"
        >
          {{ section.settings.body }}
        </div>
      {%- endif -%}
      {%- if section.settings.footnote != blank -%}
        {%- comment -%}
          Body size, not caption. A single paragraph set smaller than the one
          above it reads as a mistake rather than as an aside — the client's
          call on the technology page, where the footnote is a full sentence of
          real information. The aside quality now comes from the lighter colour
          alone, which is enough.
        {%- endcomment -%}
        <div class="hs-body hs-note__footnote hs-measure-52 hs-pretty hs-faint">
          {{ section.settings.footnote }}
        </div>
      {%- endif -%}
      {%- comment -%}
        A pointer to the nearest thing that *is* answered, so a page that is
        still being written still gives the reader somewhere to go.
      {%- endcomment -%}
      {%- if section.settings.pointer_link_label != blank -%}
        <div class="hs-note__pointer">
          {%- if section.settings.pointer_label != blank -%}
            <p class="hs-eyebrow hs-muted">{{ section.settings.pointer_label }}</p>
          {%- endif -%}
          <a class="hs-tap hs-h4 hs-note__pointer-link" href="{{ section.settings.pointer_url | default: '#' }}">
            {{- section.settings.pointer_link_label -}}
            {% render 'hs-icon', icon: 'arrow-right', size: 18, class: 'hs-note__pointer-icon' %}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.link_label != blank -%}
        <div class="hs-note__actions">
          {%- if section.settings.cta_label != blank -%}
            {% render 'hs-button',
              label: section.settings.cta_label,
              href: section.settings.cta_url,
              style: 'primary'
            %}
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            {% render 'hs-button',
              label: section.settings.link_label,
              href: section.settings.link_url,
              style: 'outline'
            %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.tail_note != blank -%}
        <div class="hs-caption hs-note__tail hs-pretty hs-faint">
          {{ section.settings.tail_note }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.note.name",
  "class": "hs-note-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "blue", "label": "t:common.scheme_blue" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "blue"
    },
    {
      "type": "checkbox",
      "id": "hide_rule",
      "label": "t:sections.cols.hide_rule",
      "default": false
    },
    {
      "type": "select",
      "id": "pace",
      "label": "t:sections.reviews.pace",
      "options": [
        { "value": "tight", "label": "t:sections.reviews.pace_tight" },
        { "value": "base", "label": "t:sections.reviews.pace_base" },
        { "value": "loose", "label": "t:sections.reviews.pace_loose" }
      ],
      "default": "base"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "rem",
      "label": "t:sections.note.max_width",
      "default": 46
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "What it will not do" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Where it stops." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.note.heading_tag",
      "info": "t:sections.note.heading_tag_info",
      "options": [
        { "value": "h2", "label": "t:sections.note.tag_h2" },
        { "value": "h1", "label": "t:sections.note.tag_h1" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.note.heading_size",
      "options": [
        { "value": "h3", "label": "t:sections.note.size_h3" },
        { "value": "h2", "label": "t:sections.note.size_h2" },
        { "value": "h1", "label": "t:sections.note.size_h1" }
      ],
      "default": "h3"
    },
    {
      "type": "checkbox",
      "id": "lead_first_para",
      "label": "t:sections.note.lead_first_para",
      "info": "t:sections.note.lead_first_para_info",
      "default": false
    },
    { "type": "richtext", "id": "body", "label": "t:common.body" },
    { "type": "richtext", "id": "footnote", "label": "t:sections.cols.footnote" },
    {
      "type": "header",
      "content": "t:sections.note.pointer"
    },
    { "type": "text", "id": "pointer_label", "label": "t:sections.note.pointer_label" },
    { "type": "text", "id": "pointer_link_label", "label": "t:sections.note.pointer_link_label" },
    { "type": "url", "id": "pointer_url", "label": "t:sections.note.pointer_url" },
    {
      "type": "header",
      "content": "t:common.actions"
    },
    { "type": "text", "id": "cta_label", "label": "t:common.cta_label" },
    { "type": "url", "id": "cta_url", "label": "t:common.cta_url" },
    { "type": "text", "id": "link_label", "label": "t:common.link_label" },
    { "type": "url", "id": "link_url", "label": "t:common.link_url" },
    { "type": "richtext", "id": "tail_note", "label": "t:sections.note.tail_note" }
  ],
  "presets": [{ "name": "t:sections.note.name" }]
}
{% endschema %}
