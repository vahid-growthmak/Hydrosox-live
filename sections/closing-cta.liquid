{%- comment -%}
  Closing CTA — the last thing on a page.

  One centred line and up to two buttons. Deliberately plain: by this point the
  argument has been made and the only job left is to offer the next step.
{%- endcomment -%}

<section
  class="hs-close hs-scheme-{{ section.settings.color_scheme }}{% if section.settings.show_rule %} hs-border-b{% endif %} hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-base hs-close__pad">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hs-h3 hs-close__heading hs-measure-22 hs-balance">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="hs-small-body hs-close__body hs-measure-52 hs-pretty hs-muted">
        {{ section.settings.body }}
      </div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank or section.settings.alt_label != blank -%}
      <div class="hs-close__actions">
        {%- if section.settings.cta_label != blank -%}
          {% render 'hs-button',
            label: section.settings.cta_label,
            href: section.settings.cta_url,
            style: 'primary'
          %}
        {%- endif -%}
        {%- if section.settings.alt_label != blank -%}
          {% render 'hs-button',
            label: section.settings.alt_label,
            href: section.settings.alt_url,
            style: 'outline'
          %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.close.name",
  "class": "hs-close-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" },
        { "value": "blue", "label": "t:common.scheme_blue" }
      ],
      "default": "paper"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "t:sections.close.show_rule",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "One sock. Long days, wet ground."
    },
    { "type": "richtext", "id": "body", "label": "t:common.body" },
    {
      "type": "header",
      "content": "t:common.actions"
    },
    { "type": "text", "id": "cta_label", "label": "t:common.cta_label", "default": "Buy a pair" },
    { "type": "url", "id": "cta_url", "label": "t:common.cta_url" },
    { "type": "text", "id": "alt_label", "label": "t:sections.close.alt_label", "default": "How it compares" },
    { "type": "url", "id": "alt_url", "label": "t:sections.close.alt_url" }
  ],
  "presets": [{ "name": "t:sections.close.name" }]
}
{% endschema %}
