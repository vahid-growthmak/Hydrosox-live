{%- comment -%}
  Company details.

  A heading row with the lede settling beside it, then one ruled four-column
  row of label/value cells — the light counterpart of the hero's spec strip.
  Each row states its own kind, so a phone number renders as a tel: link and
  an email as a mailto: without the merchant building the link. Values left
  empty fall back to the global brand settings.
{%- endcomment -%}

<section
  class="hs-company hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-loose">
    <div class="hs-company__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hs-h3 hs-company__heading hs-measure-18 hs-balance">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.lede != blank -%}
        <div class="hs-small-body hs-company__lede hs-measure-42 hs-pretty hs-muted">
          {{ section.settings.lede }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        The press fact sheet runs to eight rows, which is the longest this
        component gets. Staggering them in stops a dense block of company facts
        landing as one slab.
      {%- endcomment -%}
      <dl class="hs-company__list hs-stagger">
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            {%- liquid
              # Fall back to the global brand setting when the row is left empty.
              assign value = block.settings.value
              if value == blank
                case block.settings.kind
                  when 'tel'
                    assign value = settings.phone
                  when 'email'
                    assign value = settings.email
                  when 'address'
                    assign value = settings.address
                endcase
              endif
            -%}
            {%- if value != blank -%}
              <div class="hs-company__cell hs-reveal" {{ block.shopify_attributes }}>
                <dt class="hs-eyebrow hs-muted">{{ block.settings.label }}</dt>
                <dd class="hs-small-body hs-company__value hs-measure-24 hs-pretty">
                  {%- case block.settings.kind -%}
                    {%- when 'tel' -%}
                      <a class="hs-tap hs-company__link hs-tnum" href="tel:{{ value | replace: ' ', '' }}">{{ value }}</a>
                    {%- when 'email' -%}
                      <a class="hs-tap hs-company__link" href="mailto:{{ value }}">{{ value }}</a>
                    {%- when 'address' -%}
                      <address class="hs-company__address">
                        {%- comment -%}
                          Runs as one flowing line. A merchant who types the
                          address over several lines gets them comma-joined
                          rather than mashed together.
                        {%- endcomment -%}
                        {{- value | newline_to_br | replace: '<br />', ', ' | replace: '<br>', ', ' | strip -}}
                      </address>
                    {%- else -%}
                      {{ value }}
                  {%- endcase -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <div class="hs-company__foot">
        <a class="hs-tap hs-small-body hs-company__foot-link" href="{{ section.settings.link_url | default: '#' }}">
          {{- section.settings.link_label -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  Off by default, for the same reason as the FAQ schema: one page should describe
  the entity, or a search engine gets several competing descriptions of it.
{%- endcomment -%}
{%- if section.settings.emit_schema -%}
  {% render 'hs-schema-organization', blocks: section.blocks %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.company.name",
  "class": "hs-company-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "wash"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "about"
    },
    {
      "type": "checkbox",
      "id": "emit_schema",
      "label": "t:sections.company.emit_schema",
      "info": "t:sections.company.emit_schema_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "The company"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Who you are buying from, in full."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>If something goes wrong you should know exactly who you are dealing with. So: the company, the address, and two ways to reach a person — published here rather than buried in a policy page.</p>"
    },
    {
      "type": "header",
      "content": "t:common.actions"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:common.link_label",
      "default": "Read the questions first"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:common.link_url"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.company.block_row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label",
          "default": "Company"
        },
        {
          "type": "select",
          "id": "kind",
          "label": "t:sections.company.kind",
          "options": [
            { "value": "text", "label": "t:sections.company.kind_text" },
            { "value": "address", "label": "t:sections.company.kind_address" },
            { "value": "tel", "label": "t:sections.company.kind_tel" },
            { "value": "email", "label": "t:sections.company.kind_email" }
          ],
          "default": "text"
        },
        {
          "type": "textarea",
          "id": "value",
          "label": "t:common.value",
          "info": "t:sections.company.value_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.company.name",
      "blocks": [
        {
          "type": "row",
          "settings": { "label": "Company", "kind": "text", "value": "HydroSox, UK registered" }
        },
        {
          "type": "row",
          "settings": { "label": "Registered address", "kind": "address" }
        },
        {
          "type": "row",
          "settings": { "label": "Phone", "kind": "tel" }
        },
        {
          "type": "row",
          "settings": { "label": "Email", "kind": "email" }
        }
      ]
    }
  ]
}
{% endschema %}
