{%- comment -%}
  Construction — a sticky scroll-scrub that takes the sock apart.

  The section is a tall scroll track holding a pinned panel. Scroll progress
  through the track drives three things at once: the layers separate in the
  visual, the matching description cross-fades in, and the progress rail fills.

  Each layer is a block, so the merchant can add or remove layers and the
  track, the visual and the rail all follow.
{%- endcomment -%}

{%- liquid
  assign layers = section.blocks | where: 'type', 'layer'
  assign layer_count = layers | size

  # The frame sequence. Names are built from the prefix plus a three-digit
  # index, so assets/<prefix>000.<ext> upwards.
  assign frame_count = section.settings.frame_count | default: 0
  assign frame_prefix = section.settings.frame_prefix | default: 'hs-layer-frame-'
  assign frame_ext = section.settings.frame_ext | default: 'webp'
  assign first_frame = frame_prefix | append: '000.' | append: frame_ext
-%}

{%- if frame_count > 0 -%}
  {%- liquid
    assign frame_last = frame_count | minus: 1
  -%}
  {%- capture frame_json -%}
    [
    {%- for i in (0..frame_last) -%}
      {%- assign pad = i | prepend: '00' | slice: -3, 3 -%}
      {%- assign name = frame_prefix | append: pad | append: '.' | append: frame_ext -%}
      "{{ name | asset_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  {%- endcapture -%}
{%- endif -%}

<section
  class="hs-layers hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  {%- comment -%} Heading {%- endcomment -%}
  <div class="hs-shell hs-layers__head">
    <div class="hs-section-head">
      <div class="hs-section-head__lead">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hs-h2 hs-section-head__heading hs-measure-18 hs-balance">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
      {%- if section.settings.lede != blank or section.settings.scroll_hint != blank -%}
        <div class="hs-body hs-section-head__lede hs-measure-46 hs-pretty hs-muted">
          {{ section.settings.lede }}
          {%- if section.settings.scroll_hint != blank -%}
            <span class="hs-layers__hint">{{ section.settings.scroll_hint }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if layer_count > 0 -%}
    <div class="hs-shell">
      <hs-layers
        class="hs-layers__track"
        style="--hs-track-height: {{ section.settings.track_height }}svh;"
        data-count="{{ layer_count }}"
        data-frame-count="{{ frame_count }}"
      >
        <div class="hs-layers__pin">
          <div class="hs-layers__grid">
            {%- comment -%}
              Exploded visual — a frame sequence scrubbed by scroll position.
              The frames live in assets/ under a shared prefix, so the whole
              sequence can be swapped by uploading a new set under the same
              names and setting the count to match.
            {%- endcomment -%}
            <div class="hs-layers__visual-col">
              <div
                class="hs-layers__stage"
                {% if section.settings.stage_background != blank %}
                  style="background-color: {{ section.settings.stage_background }};"
                {% endif %}
              >
                {%- if frame_count > 0 -%}
                  {%- comment -%}
                    The first frame is a plain <img> so the stage is filled
                    immediately and still reads without JavaScript. It is
                    hidden once the canvas has painted.
                  {%- endcomment -%}
                  <img
                    class="hs-layers__first"
                    data-hs-first
                    src="{{ first_frame | asset_url }}"
                    alt="{{ section.settings.frame_alt | escape }}"
                    width="{{ section.settings.frame_width }}"
                    height="{{ section.settings.frame_height }}"
                    fetchpriority="high"
                    decoding="async"
                  >
                  <canvas
                    class="hs-layers__canvas"
                    data-hs-canvas
                    width="{{ section.settings.frame_width }}"
                    height="{{ section.settings.frame_height }}"
                    aria-hidden="true"
                  ></canvas>
                  <script type="application/json" data-hs-frames>{{ frame_json }}</script>
                {%- else -%}
                  {%- comment -%} No sequence set — fall back to a still. {%- endcomment -%}
                  {% render 'hs-image',
                    image: section.settings.fallback_image,
                    alt: section.settings.frame_alt,
                    sizes: '(min-width: 64rem) 52vw, 100vw',
                    wrapper_class: 'hs-layers__still',
                    class: 'hs-layers__still-img'
                  %}
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} Cross-fading descriptions {%- endcomment -%}
            <div class="hs-layers__copy-col">
              <div class="hs-layers__panels">
                {%- for block in layers -%}
                  <div
                    class="hs-layers__panel{% if forloop.first %} is-active{% endif %}"
                    data-hs-panel="{{ forloop.index0 }}"
                    {% unless forloop.first %}
                      aria-hidden="true"
                    {% endunless %}
                  >
                    {% render 'hs-index-number',
                      index: forloop.index0,
                      class: 'hs-layers__panel-index'
                    %}
                    {%- if block.settings.heading != blank -%}
                      <h3 class="hs-h3 hs-layers__panel-heading">{{ block.settings.heading }}</h3>
                    {%- endif -%}
                    {%- if block.settings.role != blank -%}
                      <p class="hs-eyebrow hs-layers__panel-role hs-muted">{{ block.settings.role }}</p>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="hs-body hs-layers__panel-body hs-pretty hs-muted">
                        {{ block.settings.body }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>

              {%- comment -%} Progress rail {%- endcomment -%}
              <ol class="hs-layers__rail" aria-hidden="true">
                {%- for block in layers -%}
                  <li class="hs-layers__rail-item" data-hs-rail="{{ forloop.index0 }}">
                    <span class="hs-layers__rail-track">
                      <span class="hs-layers__rail-fill"></span>
                    </span>
                    <span class="hs-eyebrow hs-layers__rail-label">{{ block.settings.heading }}</span>
                  </li>
                {%- endfor -%}
              </ol>
            </div>
          </div>
        </div>
      </hs-layers>
    </div>
  {%- endif -%}

  {%- comment -%} Footer links {%- endcomment -%}
  {%- liquid
    assign link_blocks = section.blocks | where: 'type', 'link'
    assign link_count = link_blocks | size
  -%}
  {%- if link_count > 0 -%}
    <div class="hs-shell hs-layers__foot-wrap">
      {%- comment -%}
        A centred button rather than a text link on a ruled line. The rule
        read as a section divider closing the page, and a quiet link under a
        scroll-scrub is the one place a reader has just been given a reason
        to want more — so it earns a button.
      {%- endcomment -%}
      <div class="hs-layers__foot">
        {%- for block in link_blocks -%}
          <span {{ block.shopify_attributes }}>
            {% render 'hs-button',
              label: block.settings.label,
              href: block.settings.link,
              style: 'outline'
            %}
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'hs-layers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.layers.name",
  "class": "hs-layers-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "paper"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "construction"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Construction"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Three layers, and what each one is for."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>“Waterproof” is a claim anybody can print on a label. This is the mechanism underneath it, so you can judge it rather than take our word.</p>"
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "t:sections.layers.scroll_hint",
      "default": "Scroll to take it apart."
    },
    {
      "type": "header",
      "content": "t:common.motion"
    },
    {
      "type": "range",
      "id": "track_height",
      "min": 150,
      "max": 500,
      "step": 10,
      "unit": "svh",
      "label": "t:sections.layers.track_height",
      "info": "t:sections.layers.track_height_info",
      "default": 320
    },
    {
      "type": "header",
      "content": "t:sections.layers.sequence"
    },
    {
      "type": "range",
      "id": "frame_count",
      "min": 0,
      "max": 200,
      "step": 2,
      "label": "t:sections.layers.frame_count",
      "info": "t:sections.layers.frame_count_info",
      "default": 100
    },
    {
      "type": "text",
      "id": "frame_prefix",
      "label": "t:sections.layers.frame_prefix",
      "info": "t:sections.layers.frame_prefix_info",
      "default": "hs-layer-frame-"
    },
    {
      "type": "text",
      "id": "frame_ext",
      "label": "t:sections.layers.frame_ext",
      "default": "webp"
    },
    {
      "type": "text",
      "id": "frame_alt",
      "label": "t:sections.layers.frame_alt",
      "default": "A HydroSox sock separating into its three layers"
    },
    {
      "type": "range",
      "id": "frame_width",
      "min": 320,
      "max": 2560,
      "step": 40,
      "unit": "px",
      "label": "t:sections.layers.frame_width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "frame_height",
      "min": 180,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "label": "t:sections.layers.frame_height",
      "default": 720
    },
    {
      "type": "color",
      "id": "stage_background",
      "label": "t:sections.layers.stage_background",
      "default": "#f0ede8"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "t:sections.layers.fallback_image",
      "info": "t:sections.layers.fallback_image_info"
    }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "t:sections.layers.block_layer",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:common.heading",
          "default": "Inner layer"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.layers.role",
          "default": "Next to the skin"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:common.body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:common.image",
          "info": "t:sections.layers.image_info"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:common.image_alt"
        },
        {
          "type": "color",
          "id": "tint",
          "label": "t:sections.layers.tint",
          "info": "t:sections.layers.tint_info"
        }
      ]
    },
    {
      "type": "link",
      "name": "t:sections.layers.block_link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label",
          "default": "How it compares"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:common.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.layers.name",
      "blocks": [
        {
          "type": "layer",
          "settings": {
            "heading": "Inner layer",
            "role": "Next to the skin",
            "body": "<p>A soft knitted lining that moves sweat off the foot and stops the membrane sitting against the skin.</p>",
            "tint": "#eaeef1"
          }
        },
        {
          "type": "layer",
          "settings": {
            "heading": "Porelle® membrane",
            "role": "The waterproof barrier",
            "body": "<p>A licensed third-party waterproof-breathable membrane — not a name we invented. Water cannot get in; vapour from the foot can get out. PFOA free.</p>",
            "tint": "#0093ff"
          }
        },
        {
          "type": "layer",
          "settings": {
            "heading": "Outer layer",
            "role": "Wear surface",
            "body": "<p>The knitted face that takes the abrasion inside a boot or shoe, and holds the sock's shape when it is not being worn.</p>",
            "tint": "#111111"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "How it compares",
            "link": "/#comparison"
          }
        }
      ]
    }
  ]
}
{% endschema %}
