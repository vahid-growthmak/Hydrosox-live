{%- comment -%}
  Content columns — the workhorse content section.

  A heading column that stays with the reader while a second column runs past
  it. The right column renders one of several things, chosen by `layout`:

  - list     ruled rows of title and body, optionally numbered
  - steps    the same rows, always numbered, on a rail that fills as you scroll
  - focus    larger titles and an accent rule that draws in as each row
             arrives; the emphasis treatment, for the section carrying the turn
             in an argument
  - split    each row set as title beside body rather than title above it
  - definition  term/definition pairs as an open table under a band-style
             header, two newspaper columns on a desktop; a row's `flag`
             renders in place of its value for figures not yet published
  - cards    the same items as a grid of cards rather than a stack
  - band     a full-width header (heading left, lede right, ruled off), then
             the cards run the whole width beneath it
  - stack    the header centred above the cards, for a section that reads as a
             single statement with its evidence below
  - boxes    each item an outlined box with its numeral set inside it — the
             dark-section counterpart of cards
  - panel    the heading column set as an ink panel with the section link as a
             button, beside rows carried as cards
  - gallery  a row of captioned images under a band-style header
  - prose    a single block of rich text
  - media    a single image beside the copy, six columns each

  This is the shape the design uses for almost every explanatory section, which
  is its strength and its risk: a page built from four of them in a row reads as
  one undifferentiated slab however good the writing is. `steps`, `cards` and
  `mirror` exist so consecutive sections can be told apart at a glance without
  changing a word of the copy or adding a bespoke section per page.

  Adjacent sections should differ on at least two of: colour scheme, which side
  the heading sits on, and the shape of the items.
{%- endcomment -%}

{%- liquid
  assign layout = section.settings.layout | default: 'list'
  assign items = section.blocks | where: 'type', 'item'
  assign shots = section.blocks | where: 'type', 'image'

  # Numerals are a per-section choice, never forced by a layout — they were
  # removed site-wide once and reinstated only where a mockup asks for them.
  assign show_index = section.settings.numbered

  assign list_tag = 'ul'
  if show_index
    assign list_tag = 'ol'
  endif
-%}

<section
  class="hs-cols hs-scheme-{{ section.settings.color_scheme }}{% if section.settings.hide_rule %} hs-no-rule{% else %} hs-border-b{% endif %} hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-base">
    <div
      class="hs-cols__grid hs-cols__grid--{{ layout }}{% if section.settings.mirror %} hs-cols__grid--mirror{% endif %}{% if section.settings.wide_head %} hs-cols__grid--wide{% endif %}"
    >
      {%- comment -%} Heading column {%- endcomment -%}
      <div class="hs-cols__head-col">
        {%- comment -%}
          The panel layout sets the heading column as a card on the ink scheme.
          Scheme classes carry their own surface and re-scope every on-surface
          token, so nesting one here restyles the text without any colour being
          named — and the section link is promoted from an underlined line to
          the panel's button, because a dark panel with a quiet text link reads
          as a dead end.
        {%- endcomment -%}
        <div class="hs-cols__head-sticky{% if layout == 'panel' %} hs-scheme-ink hs-cols__head-panel{% endif %}">
          {% render 'hs-eyebrow',
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading
          %}
          {%- if section.settings.heading != blank -%}
            <h2 class="hs-h2 hs-cols__heading hs-measure-18 hs-balance">
              {{- section.settings.heading -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.head_note != blank -%}
            <div class="hs-small-body hs-cols__head-note hs-measure-42 hs-pretty hs-muted">
              {{ section.settings.head_note }}
            </div>
          {%- endif -%}
          {%- if layout == 'panel' and section.settings.link_label != blank -%}
            <div class="hs-cols__panel-cta">
              {% render 'hs-button',
                label: section.settings.link_label,
                href: section.settings.link_url,
                style: 'primary'
              %}
            </div>
          {%- elsif section.settings.link_label != blank or section.settings.link2_label != blank -%}
            <p class="hs-cols__head-links">
              {%- if section.settings.link_label != blank -%}
                <a class="hs-tap hs-small-body hs-cols__head-link" href="{{ section.settings.link_url | default: '#' }}">
                  {{- section.settings.link_label -}}
                </a>
              {%- endif -%}
              {%- if section.settings.link2_label != blank -%}
                <a class="hs-tap hs-small-body hs-cols__head-link" href="{{ section.settings.link2_url | default: '#' }}">
                  {{- section.settings.link2_label -}}
                </a>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- comment -%}
            The media settings double as a heading-column figure on every
            layout except `media` (which renders them in the body column).
            The wudu three-properties section holds its design sheet under
            the sticky heading this way — the photograph stays with the
            claim while the rows scroll past it.
          {%- endcomment -%}
          {%- if layout != 'media' -%}
            {%- if section.settings.media_image != blank or section.settings.media_fallback != blank -%}
              <figure class="hs-cols__head-figure">
                {% render 'hs-image',
                  image: section.settings.media_image,
                  fallback: section.settings.media_fallback,
                  alt: section.settings.media_alt,
                  sizes: '(min-width: 64rem) 25rem, 100vw',
                  wrapper_class: 'hs-cols__head-media',
                  class: 'hs-cols__head-img'
                %}
                {%- if section.settings.media_caption != blank -%}
                  <figcaption class="hs-caption hs-cols__caption hs-pretty hs-muted">
                    {{- section.settings.media_caption -}}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Content column {%- endcomment -%}
      <div class="hs-cols__body-col">
        {%- if section.settings.lede != blank -%}
          <div class="hs-body hs-cols__lede hs-measure-58 hs-pretty hs-muted">
            {{ section.settings.lede }}
          </div>
        {%- endif -%}

        {%- case layout -%}
          {%- when 'gallery' -%}
            {%- if shots.size > 0 -%}
              <ul class="hs-cols__gallery hs-stagger" role="list">
                {%- for block in shots -%}
                  <li class="hs-reveal" {{ block.shopify_attributes }}>
                    {% render 'hs-image',
                      image: block.settings.image,
                      fallback: block.settings.image_fallback,
                      alt: block.settings.image_alt,
                      aspect: section.settings.gallery_aspect,
                      sizes: '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw',
                      wrapper_class: 'hs-cols__shot',
                      class: 'hs-cols__shot-img'
                    %}
                    {%- if block.settings.caption != blank -%}
                      <p class="hs-caption hs-cols__caption hs-pretty hs-muted">
                        {{- block.settings.caption -}}
                      </p>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'media' -%}
            {%- if section.settings.media_image != blank or section.settings.media_fallback != blank -%}
              {% render 'hs-image',
                image: section.settings.media_image,
                fallback: section.settings.media_fallback,
                alt: section.settings.media_alt,
                sizes: '(min-width: 64rem) 45vw, 100vw',
                wrapper_class: 'hs-cols__figure',
                class: 'hs-cols__figure-img'
              %}
            {%- endif -%}

          {%- when 'prose' -%}
            {%- if section.settings.prose != blank -%}
              {%- comment -%}
                `lead_first_para` sets the opening paragraph a step larger and in
                full ink, for prose whose first paragraph is written to stand on
                its own — a definition. Search snippets and LLMs both lift the
                opening paragraph, and the type size signals it is self-contained.
              {%- endcomment -%}
              <div
                class="hs-body hs-cols__prose hs-rte hs-reveal hs-measure-58 hs-pretty{% if section.settings.lead_first_para %} hs-cols__prose--lead{% endif %}"
              >
                {{ section.settings.prose }}
              </div>
            {%- endif -%}

          {%- when 'definition' -%}
            {%- comment -%}
              The open specification table: term and definition pairs under a
              band-style header, run as two newspaper columns on a desktop. A
              row whose `flag` is set renders the flag where its value would be
              — the client's "Not published yet" rows, where the honest state
              of a figure is the content — with the body demoted to the muted
              explanation of what the figure will be.
            {%- endcomment -%}
            {%- if items.size > 0 -%}
              <dl class="hs-cols__defs">
                {%- for block in items -%}
                  <div class="hs-cols__def" {{ block.shopify_attributes }}>
                    {%- if block.settings.title != blank -%}
                      <dt class="hs-eyebrow hs-cols__def-term">{{ block.settings.title }}</dt>
                    {%- endif -%}
                    <dd class="hs-cols__def-desc">
                      {%- if block.settings.flag != blank -%}
                        <span class="hs-eyebrow hs-cols__def-flag">{{ block.settings.flag }}</span>
                      {%- endif -%}
                      {%- if block.settings.body != blank -%}
                        <div class="hs-small-body hs-cols__def-body hs-measure-46 hs-pretty{% if block.settings.flag != blank %} hs-muted{% endif %}">
                          {{ block.settings.body }}
                        </div>
                      {%- endif -%}
                    </dd>
                  </div>
                {%- endfor -%}
              </dl>
            {%- endif -%}

          {%- when 'cards' or 'band' or 'stack' -%}
            {%- comment -%}
              The same items, laid out as a grid rather than a stack. A card has
              no rule above and below it and no shared left edge, so a section
              using this reads as a different kind of thing from the ruled list
              above it even though the content is identical.
            {%- endcomment -%}
            {%- if items.size > 0 -%}
              <ul class="hs-cols__cards{% if section.settings.card_columns == 'two' %} hs-cols__cards--two{% endif %}{% if section.settings.divided %} hs-cols__cards--divided{% endif %}{% if section.settings.outlined %} hs-cols__cards--outlined{% endif %} hs-stagger" role="list">
                {%- for block in items -%}
                  <li class="hs-cols__card hs-reveal" {{ block.shopify_attributes }}>
                    {%- comment -%}
                      A card carries its item's picture when there is one. The
                      `gallery` layout looks the other way — it iterates `image`
                      blocks and ignores `item` blocks entirely — so a section
                      built from items and set to gallery renders as nothing at
                      all, with the copy present in the file and invisible on
                      the page. Cards take items, so a picture belongs here.
                    {%- endcomment -%}
                    {%- if block.settings.image != blank or block.settings.image_fallback != blank -%}
                      {% render 'hs-image',
                        image: block.settings.image,
                        fallback: block.settings.image_fallback,
                        alt: block.settings.image_alt,
                        aspect: section.settings.gallery_aspect,
                        sizes: '(min-width: 64rem) 22vw, (min-width: 48rem) 45vw, 100vw',
                        wrapper_class: 'hs-cols__card-media'
                      %}
                    {%- endif -%}
                    {%- if show_index -%}
                      {% render 'hs-index-number',
                        index: forloop.index0,
                        size: 'label',
                        class: 'hs-cols__card-index hs-faint'
                      %}
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h3 class="hs-h4 hs-cols__card-title hs-balance">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="hs-small-body hs-cols__card-body hs-pretty hs-muted">
                        {{ block.settings.body }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.link_label != blank -%}
                      <a class="hs-tap hs-small-body hs-cols__row-link" href="{{ block.settings.link_url | default: '#' }}">
                        {{- block.settings.link_label -}}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- else -%}
            {%- if items.size > 0 -%}
              <{{ list_tag }} class="hs-cols__list hs-cols__list--{{ section.settings.row_density | default: 'standard' }}{% if section.settings.row_scale == 'large' %} hs-cols__list--large{% endif %}{% if layout == 'steps' %} hs-cols__list--steps{% endif %}{% if layout == 'focus' %} hs-cols__list--focus{% endif %}{% if layout == 'split' or layout == 'panel' %} hs-cols__list--split{% endif %}{% if layout == 'boxes' %} hs-cols__list--boxes{% endif %}{% if layout == 'panel' %} hs-cols__list--cardrows{% endif %} hs-stagger" role="list">
                {%- for block in items -%}
                  {%- liquid
                    assign row_has_media = false
                    if block.settings.image != blank or block.settings.image_fallback != blank
                      assign row_has_media = true
                    endif
                  -%}
                  {%- comment -%}
                    The rows carry the reveal, not the list. `hs-stagger` on the
                    parent only computes the per-child offset; without
                    `hs-reveal` on the child there is nothing for that offset to
                    delay, and a long argued list arrives as one wall of text —
                    which is exactly what these pages cannot afford.
                  {%- endcomment -%}
                  <li
                    class="hs-cols__row hs-reveal{% if row_has_media %} hs-cols__row--media{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if show_index -%}
                      {% render 'hs-index-number',
                        index: forloop.index0,
                        size: 'label',
                        class: 'hs-cols__row-index hs-faint'
                      %}
                    {%- endif -%}
                    {%- comment -%}
                      A small photograph beside the row, so a list of uses reads
                      as places rather than paragraphs. The body stays richtext,
                      which is what keeps the keyword links inside the sentences.
                    {%- endcomment -%}
                    {%- if row_has_media -%}
                      {% render 'hs-image',
                        image: block.settings.image,
                        fallback: block.settings.image_fallback,
                        alt: block.settings.image_alt,
                        aspect: '4 / 3',
                        sizes: '9rem',
                        wrapper_class: 'hs-cols__row-media',
                        class: 'hs-cols__row-img'
                      %}
                    {%- endif -%}
                    <div class="hs-cols__row-text">
                      {%- if block.settings.title != blank -%}
                        <h3 class="hs-h4 hs-cols__row-title">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.body != blank -%}
                        <div class="hs-small-body hs-cols__row-body hs-measure-56 hs-pretty hs-muted">
                          {{ block.settings.body }}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.link_label != blank -%}
                        <a class="hs-tap hs-small-body hs-cols__row-link" href="{{ block.settings.link_url | default: '#' }}">
                          {{- block.settings.link_label -}}
                        </a>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </{{ list_tag }}>
            {%- endif -%}
        {%- endcase -%}

        {%- comment -%}
          A button rather than the head's text link, for the one position where
          this section carries the page's primary action — the homepage product
          summary standing where the buy widget used to. Renders nothing until a
          label is set, so every other instance is unchanged.
        {%- endcomment -%}
        {%- if section.settings.cta_label != blank -%}
          <p class="hs-cols__cta">
            {% render 'hs-button',
              label: section.settings.cta_label,
              href: section.settings.cta_url,
              style: 'primary'
            %}
          </p>
        {%- endif -%}

        {%- if section.settings.footnote != blank -%}
          <p class="hs-caption hs-cols__footnote hs-measure-52 hs-pretty hs-faint">
            {{- section.settings.footnote -}}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.cols.name",
  "class": "hs-cols-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" },
        { "value": "blue", "label": "t:common.scheme_blue" }
      ],
      "default": "paper"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.cols.layout",
      "options": [
        { "value": "list", "label": "t:sections.cols.layout_list" },
        { "value": "steps", "label": "t:sections.cols.layout_steps" },
        { "value": "focus", "label": "t:sections.cols.layout_focus" },
        { "value": "split", "label": "t:sections.cols.layout_split" },
        { "value": "definition", "label": "t:sections.cols.layout_definition" },
        { "value": "cards", "label": "t:sections.cols.layout_cards" },
        { "value": "band", "label": "t:sections.cols.layout_band" },
        { "value": "stack", "label": "t:sections.cols.layout_stack" },
        { "value": "boxes", "label": "t:sections.cols.layout_boxes" },
        { "value": "panel", "label": "t:sections.cols.layout_panel" },
        { "value": "gallery", "label": "t:sections.cols.layout_gallery" },
        { "value": "prose", "label": "t:sections.cols.layout_prose" },
        { "value": "media", "label": "t:sections.cols.layout_media" }
      ],
      "default": "list"
    },
    {
      "type": "checkbox",
      "id": "mirror",
      "label": "t:sections.cols.mirror",
      "info": "t:sections.cols.mirror_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "t:sections.cols.numbered",
      "info": "t:sections.cols.numbered_info",
      "default": false
    },
    {
      "type": "select",
      "id": "row_density",
      "label": "t:sections.cols.row_density",
      "options": [
        { "value": "standard", "label": "t:sections.cols.row_density_standard" },
        { "value": "compact", "label": "t:sections.cols.row_density_compact" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "row_scale",
      "label": "t:sections.cols.row_scale",
      "options": [
        { "value": "standard", "label": "t:sections.cols.row_density_standard" },
        { "value": "large", "label": "t:sections.cols.row_scale_large" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "wide_head",
      "label": "t:sections.cols.wide_head",
      "info": "t:sections.cols.wide_head_info",
      "default": false
    },
    {
      "type": "select",
      "id": "card_columns",
      "label": "t:sections.cols.card_columns",
      "options": [
        { "value": "auto", "label": "t:sections.cols.card_columns_auto" },
        { "value": "two", "label": "t:sections.cols.card_columns_two" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "divided",
      "label": "t:sections.cols.divided",
      "info": "t:sections.cols.divided_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "outlined",
      "label": "t:sections.cols.outlined",
      "info": "t:sections.cols.outlined_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_rule",
      "label": "t:sections.cols.hide_rule",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info"
    },
    {
      "type": "header",
      "content": "t:sections.cols.heading_column"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "The problem"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "What this section is about."
    },
    {
      "type": "richtext",
      "id": "head_note",
      "label": "t:sections.cols.head_note"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:common.link_label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:common.link_url"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "t:sections.cols.link2_label"
    },
    {
      "type": "url",
      "id": "link2_url",
      "label": "t:sections.cols.link2_url"
    },
    {
      "type": "header",
      "content": "t:sections.cols.content_column"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede"
    },
    {
      "type": "checkbox",
      "id": "lead_first_para",
      "label": "t:sections.cols.lead_first_para",
      "info": "t:sections.cols.lead_first_para_info",
      "default": false
    },
    {
      "type": "richtext",
      "id": "prose",
      "label": "t:sections.cols.prose",
      "info": "t:sections.cols.prose_info"
    },
    {
      "type": "text",
      "id": "gallery_aspect",
      "label": "t:sections.cols.gallery_aspect",
      "info": "t:sections.cols.gallery_aspect_info",
      "default": "4 / 5"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "t:sections.cols.footnote"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.cols.cta_label",
      "info": "t:sections.cols.cta_label_info"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:sections.cols.cta_url"
    },
    {
      "type": "header",
      "content": "t:sections.cols.media_header"
    },
    { "type": "image_picker", "id": "media_image", "label": "t:common.image" },
    {
      "type": "text",
      "id": "media_fallback",
      "label": "t:sections.cols.image_fallback",
      "info": "t:sections.cols.image_fallback_info"
    },
    { "type": "text", "id": "media_alt", "label": "t:common.image_alt" },
    { "type": "text", "id": "media_caption", "label": "t:sections.cols.caption" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.cols.block_item",
      "settings": [
        { "type": "text", "id": "title", "label": "t:common.title", "default": "A point worth making" },
        { "type": "richtext", "id": "body", "label": "t:common.body" },
        {
          "type": "text",
          "id": "flag",
          "label": "t:sections.cols.flag",
          "info": "t:sections.cols.flag_info"
        },
        { "type": "text", "id": "link_label", "label": "t:common.link_label" },
        { "type": "url", "id": "link_url", "label": "t:common.link_url" },
        {
          "type": "checkbox",
          "id": "link_title",
          "label": "t:sections.cols.link_title",
          "info": "t:sections.cols.link_title_info",
          "default": false
        },
        { "type": "image_picker", "id": "image", "label": "t:common.image" },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "t:sections.cols.image_fallback",
          "info": "t:sections.cols.image_fallback_info"
        },
        { "type": "text", "id": "image_alt", "label": "t:common.image_alt" }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.cols.block_image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:common.image" },
