{%- comment -%}
  Last-resort destination for this section's calls to action.

  Several sections ship a default CTA label with no default URL, so a template
  that never set one renders `hs-button` without an href — and that is a real
  <button> that looks completely normal and does nothing when clicked. Neither
  theme check nor the settings validator looks at a label and its URL together,
  so it stays invisible until someone taps it.

  Falling back to the product named in theme settings means the worst case is a
  link to the thing being sold rather than a dead control. A URL set on the
  section still wins, and templates set `#buy` where the page has the widget.
{%- endcomment -%}
{%- assign hs_cta_fallback = all_products[settings.schema_product].url | default: routes.all_products_collection_url -%}
{%- assign hs_cta_href = section.settings.cta_link | default: hs_cta_fallback -%}
{%- comment -%}
  Questions.

  Two columns: the heading, lede and help prompt sit in a sticky left column;
  the questions run down the right as native <details>, so every answer is
  readable, findable in-page, and expandable before any JavaScript runs. The
  call to action closes the right column.
{%- endcomment -%}

{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
  assign question_count = questions | size

  # ---------------------------------------------------------------------------
  # Questions from the blog post.
  #
  # On a blog post, with "Questions from" set to the post, the questions are
  # the post's own rather than this section's blocks, so one section on the
  # article template serves every guide. They come from the post's FAQs field
  # (article.metafields.custom.faqs, a list of `faq` metaobject entries with
  # `question` and `answer` fields) when it has entries, otherwise from the
  # post body: a heading 2 containing "Frequently asked questions" (or "FAQ"),
  # then one heading 3 per question with the answer beneath it. main-article
  # lifts that part out of the body so it is not shown twice.
  #
  # Liquid has no arrays to build into, so questions and answers collect as
  # two strings joined on a marker that cannot occur in the content, then split.
  # A post with no questions renders nothing — the blocks below are for the
  # other pages this section serves, and are never shown on a post instead.
  # ---------------------------------------------------------------------------
  assign use_article = false
  if section.settings.source == 'article' and article != blank
    assign use_article = true
  endif

  if use_article
    assign faq_sep = '<!--hs-faq-sep-->'
    assign faq_q_raw = ''
    assign faq_a_raw = ''
    assign question_count = 0

    for entry in article.metafields.custom.faqs.value
      assign q_text = entry.question.value | strip_html | strip
      if entry.answer.type == 'rich_text_field'
        assign a_html = entry.answer | metafield_tag
      else
        assign a_html = entry.answer.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
      endif
      assign a_text = a_html | strip_html | strip
      if q_text == blank or a_text == blank
        continue
      endif
      if question_count > 0
        assign faq_q_raw = faq_q_raw | append: faq_sep
        assign faq_a_raw = faq_a_raw | append: faq_sep
      endif
      assign faq_q_raw = faq_q_raw | append: q_text
      assign faq_a_raw = faq_a_raw | append: a_html
      assign question_count = question_count | plus: 1
    endfor

    if question_count == 0
      assign h2_parts = article.content | split: '<h2'
      for part in h2_parts
        if forloop.first
          continue
        endif
        assign part_bits = part | split: '</h2>'
        assign heading_key = part_bits.first | prepend: '<h2' | strip_html | strip | downcase
        unless heading_key contains 'frequently asked' or heading_key contains 'faq'
          continue
        endunless
        assign faq_body = part | remove_first: part_bits.first | remove_first: '</h2>'
        assign h3_parts = faq_body | split: '<h3'
        for q_part in h3_parts
          if forloop.first
            continue
          endif
          assign q_bits = q_part | split: '</h3>'
          if q_bits.size < 2
            continue
          endif
          assign q_text = q_bits.first | prepend: '<h3' | strip_html | strip
          assign a_html = q_part | remove_first: q_bits.first | remove_first: '</h3>' | strip
          assign a_text = a_html | strip_html | strip
          if q_text == blank or a_text == blank
            continue
          endif
          if question_count > 0
            assign faq_q_raw = faq_q_raw | append: faq_sep
            assign faq_a_raw = faq_a_raw | append: faq_sep
          endif
          assign faq_q_raw = faq_q_raw | append: q_text
          assign faq_a_raw = faq_a_raw | append: a_html
          assign question_count = question_count | plus: 1
        endfor
        break
      endfor
    endif

    assign faq_questions = faq_q_raw | split: faq_sep
    assign faq_answers = faq_a_raw | split: faq_sep
  endif
-%}

{%- if use_article and question_count == 0 -%}
  {%- if request.design_mode -%}
    <section class="hs-faq hs-scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
      <div class="hs-shell hs-pace-tight">
        <p class="hs-small-body hs-muted">{{ section.settings.article_empty_note }}</p>
      </div>
    </section>
  {%- endif -%}
{%- else -%}

<section
  class="hs-faq hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-base">
    <div class="hs-faq__grid">
      {%- comment -%} Sticky lead column {%- endcomment -%}
      <div class="hs-faq__lead">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hs-h3 hs-faq__heading hs-measure-15 hs-balance">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <div class="hs-small-body hs-faq__lede hs-measure-36 hs-pretty hs-muted">
            {{ section.settings.lede }}
          </div>
        {%- endif -%}
        {%- if section.settings.help_label != blank -%}
          <p class="hs-small-body hs-faq__help hs-measure-34 hs-pretty hs-muted">
            {{ section.settings.help_prefix }}
            <a class="hs-tap hs-faq__help-link" href="{{ section.settings.help_link | default: '#' }}">
              {{- section.settings.help_label -}}
            </a>
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} Questions column {%- endcomment -%}
      {%- if question_count > 0 -%}
        {%- comment -%}
          A list of eight closed questions is the densest-looking block on these
          pages, and the one most likely to read as a wall. Staggering the rows
          in gives it a rhythm as it arrives; the answers themselves still open
          instantly, and the whole thing renders open and static under
          prefers-reduced-motion.
        {%- endcomment -%}
        <hs-accordion
          class="hs-faq__list hs-stagger"
          {% if section.settings.one_at_a_time %}
            data-single
          {% endif %}
        >
          {%- if use_article -%}
            {%- for q_text in faq_questions -%}
              <details class="hs-faq__item hs-reveal">
                <summary class="hs-faq__summary">
                  <span class="hs-h4 hs-faq__question hs-measure-30 hs-pretty">
                    {{- q_text -}}
                  </span>
                  <span class="hs-faq__marker" aria-hidden="true">
                    {% render 'hs-icon', icon: 'plus', size: 20 %}
                  </span>
                </summary>
                <div class="hs-faq__answer-wrap">
                  <div class="hs-small-body hs-rte hs-faq__answer hs-measure-62 hs-pretty hs-muted">
                    {{ faq_answers[forloop.index0] }}
                  </div>
                </div>
              </details>
            {%- endfor -%}
          {%- else -%}
          {%- for block in questions -%}
            <details class="hs-faq__item hs-reveal" {{ block.shopify_attributes }}>
              <summary class="hs-faq__summary">
                <span class="hs-h4 hs-faq__question hs-measure-30 hs-pretty">
                  {{- block.settings.question -}}
                </span>
                <span class="hs-faq__marker" aria-hidden="true">
                  {% render 'hs-icon', icon: 'plus', size: 20 %}
                </span>
              </summary>
              <div class="hs-faq__answer-wrap">
                <div class="hs-small-body hs-faq__answer hs-measure-62 hs-pretty hs-muted">
                  {{ block.settings.answer }}
                </div>
              </div>
            </details>
          {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <div class="hs-faq__foot">
              {% render 'hs-button',
                label: section.settings.cta_label,
                href: hs_cta_href,
                style: 'primary'
              %}
              {%- if section.settings.cta_note != blank -%}
                <p class="hs-caption hs-faq__foot-note hs-measure-30 hs-pretty hs-muted">
                  {{ section.settings.cta_note }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </hs-accordion>

        <script src="{{ 'hs-accordion.js' | asset_url }}" defer></script>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}
  Off by default. Only one page of the site should claim FAQPage for a given set
  of questions — two pages carrying it for the same wording compete for the same
  rich result rather than reinforcing each other.
{%- endcomment -%}
{%- if section.settings.emit_schema -%}
  {%- if use_article -%}
    {%- if question_count > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for q_text in faq_questions -%}
              {%- liquid
                assign q_json = q_text | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#39;', "'" | replace: '&quot;', '"' | json
                assign a_json = faq_answers[forloop.index0] | strip_html | strip | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#39;', "'" | replace: '&quot;', '"' | json
              -%}
              {%- unless forloop.first %},{% endunless -%}
              {
                "@type": "Question",
                "name": {{ q_json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ a_json }} }
              }
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  {%- else -%}
    {% render 'hs-schema-faq', blocks: section.blocks %}
  {%- endif -%}
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "hs-faq-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "paper"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "faq"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.faq.source",
      "info": "t:sections.faq.source_info",
      "options": [
        { "value": "blocks", "label": "t:sections.faq.source_blocks" },
        { "value": "article", "label": "t:sections.faq.source_article" }
      ],
      "default": "blocks"
    },
    {
      "type": "text",
      "id": "article_empty_note",
      "label": "t:sections.faq.article_empty_note",
      "default": "This blog post has no questions yet, so this section is hidden on the live site. Add them on the post under Metafields → FAQs, or as a \"Frequently asked questions\" heading 2 in the post with one heading 3 per question."
    },
    {
      "type": "checkbox",
      "id": "one_at_a_time",
      "label": "t:sections.faq.one_at_a_time",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "emit_schema",
      "label": "t:sections.faq.emit_schema",
      "info": "t:sections.faq.emit_schema_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "The things people ask before they buy."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>Answered with the same facts as the rest of this page. If one of them contradicts something above, the answer above is the one that is wrong.</p>"
    },
    {
      "type": "text",
      "id": "help_prefix",
      "label": "t:sections.faq.help_prefix",
      "default": "Something not here?"
    },
    {
      "type": "text",
      "id": "help_label",
      "label": "t:sections.faq.help_label",
      "default": "Phone or email us"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "t:common.link"
    },
    {
      "type": "header",
      "content": "t:common.actions"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:common.button_label",
      "default": "Buy a pair"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:common.button_link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "t:sections.faq.cta_note",
      "default": "Two decisions and a quantity. No account needed."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.block_question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.question",
          "default": "Are these actually waterproof, or just water resistant?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are these actually waterproof, or just water resistant?",
            "answer": "<p>Waterproof. The middle layer is a Porelle® membrane — a licensed third-party laminate, not a name we invented — sealed inside a three-layer knit. Water that goes in over the top of the cuff is inside the sock, and no waterproof sock behaves otherwise.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Will my feet still sweat?",
            "answer": "<p>If you work hard enough, yes. The membrane moves vapour out, which delays the point at which the foot is wet from the inside. It does not repeal it. Breathable and dry are not the same word.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do they replace waterproof boots?",
            "answer": "<p>No. They are one component of a system. If your footwear is wrong for the ground you are on, a sock will not fix it.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What size should I order?",
            "answer": "<p>Four bands: S covers UK 3-5, M covers UK 6-8, L covers UK 9-11, XL covers UK 12-14. The size guide opens over the buy widget without leaving the page, and it is measurement-led — shoe sizing is not consistent between brands.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How much is delivery?",
            "answer": "<p>Free UK delivery on two pairs or more. On a single pair, delivery is charged at checkout and shown before you pay. No delivery speed is printed anywhere on this site, because we will not promise one that confirmed stock cannot support.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Why are there no reviews on this site?",
            "answer": "<p>Because there are none yet. HydroSox is new, and a rating with nothing behind it is worth nothing. When there is real review volume it will be published here — including the reviews that do not flatter us.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Who am I buying from?",
            "answer": "<p>HydroSox, a UK registered company at 399-405 Oxford Street, Mayfair, London W1C 2BU. The phone number and email are published on every page of this site, not held behind a contact form.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
