{%- comment -%}
  Feature band — a compact single-row statement.

  Eyebrow, heading and supporting line stacked on the left; an arrow link on
  the right whose gap opens slightly on hover. Used on the homepage for the
  wudu claim, but deliberately generic: any single claim that needs its own
  quiet band.
{%- endcomment -%}

<section
  class="hs-band hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-band__pad">
    <div class="hs-band__row">
      <div class="hs-band__main">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hs-h4 hs-band__heading hs-measure-34 hs-balance">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="hs-small-body hs-band__body hs-measure-64 hs-pretty hs-muted">
            {{ section.settings.body }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank -%}
        <a class="hs-tap hs-small-body hs-band__link" href="{{ section.settings.link_url | default: '#' }}">
          {{ section.settings.link_label }}
          {% render 'hs-icon', icon: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.band.name",
  "class": "hs-band-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "wash"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:common.body"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:common.link_label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:common.link_url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.band.name",
      "settings": {
        "eyebrow": "Designed with wudu in mind",
        "heading": "Built for the three conditions masah turns on.",
        "body": "<p>Waterproof, structured to hold its shape, shaped to stay on the foot — the three physical properties the masah conditions rest on. No certificate has been issued yet, and we say so plainly on the page.</p>",
        "link_label": "How it is built for masah"
      }
    }
  ]
}
{% endschema %}
