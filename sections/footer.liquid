{%- comment -%}
  Footer.

  Three link columns and a company column that sits last on wide screens.
  A "column" block takes its links either from a navigation menu — managed
  once under Navigation — or from the "column link" blocks that follow it in
  the editor; the menu wins when both are set. The closing row carries the
  brand mark, the legal links and the fine print.
{%- endcomment -%}

<footer class="hs-footer hs-scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="hs-shell hs-footer__pad">
    <div class="hs-footer__top">
      {%- comment -%} Company column — pushed last on wide screens {%- endcomment -%}
      <div class="hs-footer__company">
        {%- if section.settings.company_heading != blank -%}
          <h3 class="hs-eyebrow hs-footer__col-heading hs-faint">{{ section.settings.company_heading }}</h3>
        {%- endif -%}

        <address class="hs-caption hs-footer__address">
          {%- if settings.address != blank -%}
            <p class="hs-footer__address-lines hs-leading-relaxed hs-muted">
              {{ settings.address | newline_to_br }}
            </p>
          {%- endif -%}
          <p class="hs-footer__contact">
            {%- if settings.phone != blank -%}
              <a class="hs-tap hs-tnum hs-footer__contact-link" href="tel:{{ settings.phone | replace: ' ', '' }}">
                {{- settings.phone -}}
              </a>
            {%- endif -%}
            {%- if settings.email != blank -%}
              <a class="hs-tap hs-footer__contact-link" href="mailto:{{ settings.email }}">
                {{- settings.email -}}
              </a>
            {%- endif -%}
          </p>
        </address>

        {% render 'hs-social' %}
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="hs-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="hs-eyebrow hs-footer__col-heading hs-faint">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <ul class="hs-footer__list" role="list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a class="hs-caption hs-footer__link" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for item in section.blocks offset: forloop.index -%}
                  {%- unless item.type == 'column_link' -%}
                    {%- break -%}
                  {%- endunless -%}
                  <li {{ item.shopify_attributes }}>
                    <a class="hs-caption hs-footer__link" href="{{ item.settings.link | default: '#' }}">
                      {{- item.settings.label -}}
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Legal row {%- endcomment -%}
    <div class="hs-footer__bottom">
      {% render 'hs-logo', inverse: true, class: 'hs-footer__mark' %}

      {%- liquid
        assign has_legal = false
        for block in section.blocks
          if block.type == 'legal_link'
            assign has_legal = true
            break
          endif
        endfor
      -%}
      {%- if has_legal -%}
        <ul class="hs-footer__legal" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'legal_link' -%}
              <li {{ block.shopify_attributes }}>
                <a class="hs-caption hs-footer__legal-link" href="{{ block.settings.link | default: '#' }}">
                  {{- block.settings.label -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.fineprint != blank -%}
        <p class="hs-caption hs-footer__fineprint hs-faint">{{ section.settings.fineprint }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "hs-footer-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "ink", "label": "t:common.scheme_ink" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "paper", "label": "t:common.scheme_paper" }
      ],
      "default": "ink"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "t:sections.footer.company_heading",
      "default": "Company"
    },
    {
      "type": "textarea",
      "id": "fineprint",
      "label": "t:sections.footer.fineprint",
      "default": "HydroSox is a UK registered company. All prices in GBP and include VAT."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.footer.block_column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:common.heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.column_menu",
          "info": "t:sections.footer.column_menu_info"
        }
      ]
    },
    {
      "type": "column_link",
      "name": "t:sections.footer.block_column_link",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.block_column_link_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:common.link"
        }
      ]
    },
    {
      "type": "legal_link",
      "name": "t:sections.footer.block_legal",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:common.link"
        }
      ]
    }
  ]
}
{% endschema %}
