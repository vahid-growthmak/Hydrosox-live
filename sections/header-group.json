/* Header section group.
   Re-stamped 2026-08-04. The dropdown picture settings (image_fallback,
   image_alt, focal_point, image_zoom) were added to sections/header.liquid and
   used here in the same commit. Shopify validated this file against the schema
   it held at that moment, did not recognise them, and silently dropped all four
   while still reporting the file as updated — so the mega menu fell back to its
   plain text list on the live store. The schema is deployed now, so this stamp
   exists only to put the file back in a diff: Shopify's GitHub sync applies the
   newest commit's changes and never revisits a file that has not changed.

   Lesson: land a section's schema first, then the values that use it. */
{
  "name": "t:section_groups.header",
  "type": "header",
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "blocks": {
        "delivery": {
          "type": "message",
          "settings": {
            "text": "Free UK delivery on two pairs or more",
            "link": "/pages/shipping-and-delivery"
          }
        },
        "shop": {
          "type": "message",
          "settings": {
            "text": "Shop the socks",
            "link": "/#buy",
            "hide_on_mobile": true
          }
        }
      },
      "block_order": [
        "delivery",
        "shop"
      ],
      "settings": {
        "color_scheme": "ink",
        "divider": "/"
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "shop": {
          "type": "link",
          "settings": {
            "label": "Shop",
            "link": "/products/hydrosox-waterproof-socks"
          }
        },
        "activity": {
          "type": "dropdown",
          "settings": {
            "label": "Shop by Use",
            "link": "/#activity"
          }
        },
        "act_hiking": {
          "type": "dropdown_item",
          "settings": {
            "label": "Hiking & Walking",
            "description": "Boots that wet out four hours into a long day in the hills.",
            "link": "/pages/hiking-and-walking",
            "image_fallback": "activity-hiking.webp",
            "image_alt": "Hiking on a wet hillside in HydroSox waterproof socks",
            "focal_point": "66% 52%",
            "image_zoom": 210
          }
        },
        "act_boots": {
          "type": "dropdown_item",
          "settings": {
            "label": "All Day in Boots",
            "description": "Boots that keep the rain out and then seal the sweat in.",
            "link": "/pages/all-day-in-boots",
            "image_fallback": "activity-all-day-in-boots.webp",
            "image_alt": "A long shift in work boots wearing HydroSox waterproof socks",
            "focal_point": "63% 45%",
            "image_zoom": 150
          }
        },
        "act_cycling": {
          "type": "dropdown_item",
          "settings": {
            "label": "Cycling & Commuting",
            "description": "Overshoes that leak at the ankle, and shoes still wet at home time.",
            "link": "/pages/cycling-and-commuting",
            "image_fallback": "activity-cycling-and-commuting.webp",
            "image_alt": "Riding on a city road in HydroSox waterproof socks",
            "focal_point": "52% 66%",
            "image_zoom": 200
          }
        },
        "act_running": {
          "type": "dropdown_item",
          "settings": {
            "label": "Running & Trail",
            "description": "Cold, soaked feet on winter miles, and blisters in a wet race.",
            "link": "/pages/running-and-trail",
            "image_fallback": "activity-running-and-trail.webp",
            "image_alt": "Running a wet winter trail in HydroSox waterproof socks",
            "focal_point": "45% 56%",
            "image_zoom": 180
          }
        },
        "technology": {
          "type": "link",
          "settings": {
            "label": "Technology",
            "link": "/pages/technology"
          }
        },
        "guides": {
          "type": "link",
          "settings": {
            "label": "Guides",
            "link": "/blogs/guides"
          }
        },
        "about": {
          "type": "link",
          "settings": {
            "label": "About",
            "link": "/pages/about"
          }
        },
        "act_wudu": {
          "type": "dropdown_item",
          "settings": {
            "label": "Wudu & Masah",
            "description": "Wudu at work, five times a day, without taking your socks off.",
            "link": "/pages/wudu-socks",
            "image_fallback": "activity-wudu-masah.webp",
            "image_alt": "Pulling on a pair of white HydroSox while seated",
            "focal_point": "50% 60%",
            "image_zoom": 100,
            "full_width": true
          }
        }
      },
      "block_order": [
        "shop",
        "activity",
        "act_wudu",
        "act_hiking",
        "act_boots",
        "act_cycling",
        "act_running",
        "technology",
        "guides",
        "about"
      ],
      "settings": {
        "color_scheme": "paper",
        "nav_label": "Primary",
        "show_search": true,
        "mobile_breakpoint": "64",
        "cta_label": "Shop HydroSox",
        "cta_link": "/products/hydrosox-waterproof-socks",
        "drawer_heading": "Menu"
      }
    }
  },
  "order": [
    "announcement",
    "header"
  ]
}
