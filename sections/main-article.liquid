{%- comment -%}
  Guide article.

  Carries the article header, a table of contents, the body, the article's own
  questions and the mandatory activity link. The breadcrumb, inline buy widget,
  related guides and email capture around it are separate sections in
  templates/article.json.

  Layout: the header and hero sit centred; below them the body runs in a
  centred reading column with the contents list in the left gutter on wide
  screens, and as a collapsible "In this guide" panel above the body on small
  ones. Every heading in the body is given an id here, so the contents list,
  shared links and the FAQ jump all land on the right heading.

  Questions are not rendered here. They live in their own Questions section
  (faq-accordion, "Questions from: this blog post") below this one in
  templates/article.json, so they can be moved, restyled or removed in the
  theme editor like the questions on every other page. This section's only
  part in it: when "Move the post's FAQ into the Questions section" is on, a
  "Frequently asked questions" heading 2 in the body — and everything under it
  up to the next heading 2 — is left out of the body, so the questions are not
  shown twice, and the contents list links down to them.

  The sitemap makes one rule structural rather than editorial: every article
  must route to exactly one activity page, so no article is a dead end. The
  article's own tags decide which — a block maps each tag to its page, so the
  routing is set per article in the blog editor rather than per template. If an
  article carries no matching tag the band is omitted on the storefront and a
  notice appears in the theme editor instead, which is where a guardrail is
  actually useful.
{%- endcomment -%}

{%- liquid
  # Resolve the article's activity from its tags. The first match wins, so an
  # article tagged for two activities still routes to exactly one.
  assign activity_label = ''
  assign activity_url = ''
  assign activity_note = ''
  for block in section.blocks
    if block.type != 'activity_link' or block.settings.tag == blank
      continue
    endif
    if article.tags contains block.settings.tag
      assign activity_label = block.settings.label
      assign activity_url = block.settings.url
      assign activity_note = block.settings.note
      break
    endif
  endfor

  # Does this post have questions for the Questions section to show?
  assign has_faq = false
  if article.metafields.custom.faqs.value.size > 0
    assign has_faq = true
  endif

  # ---------------------------------------------------------------------------
  # Walk the body's heading 2s once: give each an id, collect the contents
  # list, and leave out the FAQ part.
  # ---------------------------------------------------------------------------
  assign body_html = ''
  assign toc_items = ''
  assign toc_count = 0
  assign h2_parts = article.content | split: '<h2'

  for part in h2_parts
    if forloop.first
      assign body_html = part
      continue
    endif

    assign part_bits = part | split: '</h2>'
    assign heading_text = part_bits.first | prepend: '<h2' | strip_html | strip
    assign heading_key = heading_text | downcase

    assign is_faq = false
    if heading_key contains 'frequently asked' or heading_key contains 'faq'
      assign is_faq = true
    endif

    if is_faq and section.settings.lift_faq
      # Shown by the Questions section instead; see the note at the top.
      assign has_faq = true
      continue
    endif

    # An ordinary section: give its heading an id. The id goes first, so if
    # the editor already wrote one this one is the id the browser keeps.
    assign heading_id = heading_text | handleize
    if heading_id == blank
      assign heading_id = 'section-' | append: forloop.index0
    endif
    assign body_html = body_html | append: '<h2 id="' | append: heading_id | append: '"' | append: part

    if heading_text != blank
      assign toc_count = toc_count | plus: 1
      assign toc_items = toc_items | append: '<li><a class="hs-article__toc-link" href="#' | append: heading_id | append: '">' | append: heading_text | append: '</a></li>'
    endif
  endfor

  if has_faq and section.settings.lift_faq and section.settings.faq_toc_label != blank
    assign faq_toc_text = section.settings.faq_toc_label | escape
    assign toc_items = toc_items | append: '<li><a class="hs-article__toc-link" href="#faq">' | append: faq_toc_text | append: '</a></li>'
    assign toc_count = toc_count | plus: 1
  endif

  assign show_toc = false
  if section.settings.show_toc and toc_count >= section.settings.toc_min
    assign show_toc = true
  endif

  # Reading time, from the words in the body.
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | divided_by: section.settings.words_per_minute
  if read_minutes < 1
    assign read_minutes = 1
  endif
-%}

<section class="hs-scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="hs-shell hs-pace-base">
    <article class="hs-article">
      {%- comment -%} Article header {%- endcomment -%}
      <header class="hs-article__head">
        <p class="hs-eyebrow hs-article__kicker">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{- article.published_at | date: format: 'date' -}}
          </time>
          {%- if section.settings.show_read_time and section.settings.read_time_label != blank -%}
            <span class="hs-article__kicker-sep" aria-hidden="true">
              {{- section.settings.kicker_divider -}}
            </span>
            <span>{{ read_minutes }} {{ section.settings.read_time_label }}</span>
          {%- endif -%}
          {%- if section.settings.show_author and article.author != blank -%}
            <span class="hs-article__kicker-sep" aria-hidden="true">
              {{- section.settings.kicker_divider -}}
            </span>
            <span>{{ 'blogs.article.by' | t: author: article.author }}</span>
          {%- endif -%}
        </p>

        <h1 class="hs-h1 hs-article__title hs-balance">{{ article.title }}</h1>

        {%- if article.excerpt != blank -%}
          <div class="hs-hero-body hs-article__standfirst hs-pretty hs-muted">
            {{ article.excerpt }}
          </div>
        {%- endif -%}
      </header>

      {%- if article.image -%}
        {%- assign hero_alt = article.image.alt | default: article.title -%}
        {% render 'hs-image',
          image: article.image,
          alt: hero_alt,
          aspect: section.settings.image_aspect,
          eager: true,
          sizes: '(min-width: 80rem) 72rem, 100vw',
          wrapper_class: 'hs-article__hero'
        %}
      {%- endif -%}

      <div class="hs-article__layout{% if show_toc %} hs-article__layout--toc{% endif %}">
        {%- if show_toc -%}
          <aside class="hs-article__aside">
            <nav class="hs-article__toc" aria-label="{{ section.settings.toc_label | escape }}">
              <p class="hs-eyebrow hs-article__toc-title">{{ section.settings.toc_label }}</p>
              <ol class="hs-article__toc-list" role="list">
                {{- toc_items -}}
              </ol>
            </nav>
          </aside>
        {%- endif -%}

        <div class="hs-article__main">
          {%- if show_toc -%}
            <details class="hs-article__toc-fold">
              <summary class="hs-article__toc-summary">
                <span class="hs-eyebrow">{{ section.settings.toc_label }}</span>
                {% render 'hs-icon', icon: 'chevron-down', size: 18, class: 'hs-article__toc-chevron' %}
              </summary>
              <ol class="hs-article__toc-list" role="list">
                {{- toc_items -}}
              </ol>
            </details>
          {%- endif -%}

          {%- comment -%} Article body {%- endcomment -%}
          <div class="hs-body hs-rte hs-article__body hs-pretty">
            {{ body_html }}
          </div>

          {%- comment -%} Mandatory activity link {%- endcomment -%}
          {%- if activity_label != blank and activity_url != blank -%}
            <aside class="hs-article__route">
              {%- if section.settings.route_eyebrow != blank -%}
                <p class="hs-eyebrow">{{ section.settings.route_eyebrow }}</p>
              {%- endif -%}
              <a class="hs-h4 hs-article__route-link" href="{{ activity_url }}">
                {{ activity_label }}
                {% render 'hs-icon', icon: 'arrow-right', size: 18 %}
              </a>
              {%- if activity_note != blank -%}
                <p class="hs-small-body hs-article__route-note hs-measure-54 hs-pretty hs-muted">
                  {{ activity_note }}
                </p>
              {%- endif -%}
            </aside>
          {%- elsif request.design_mode -%}
            {%- comment -%}
              Editor only. The storefront shows nothing rather than an empty band.
            {%- endcomment -%}
            <aside class="hs-article__route hs-article__route--unset">
              <p class="hs-small-body">{{ section.settings.route_missing_note }}</p>
            </aside>
          {%- endif -%}

          {%- if section.settings.back_label != blank -%}
            <p class="hs-article__back">
              <a class="hs-guides__all hs-link" href="{{ blog.url }}">
                {% render 'hs-icon', icon: 'arrow-right', size: 16, class: 'hs-article__back-icon' %}
                {{ section.settings.back_label }}
              </a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </article>
  </div>
</section>

{%- comment -%}
  Structured data for the article itself. FAQPage comes from the Questions
  section, from the same questions it renders.
{%- endcomment -%}
{%- if section.settings.emit_article_schema -%}
  {%- liquid
    assign ld_description = article.excerpt_or_content | strip_html | strip | truncate: 300
    assign ld_url = request.origin | append: article.url
    assign ld_publisher = shop.name
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "description": {{ ld_description | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "mainEntityOfPage": {{ ld_url | json }},
      "url": {{ ld_url | json }},
      "wordCount": {{ word_count | json }},
      {%- if article.image %}
      "image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},
      {%- endif %}
      "author": { "@type": "Organization", "name": {{ ld_publisher | json }}, "url": {{ request.origin | json }} },
      "publisher": { "@type": "Organization", "name": {{ ld_publisher | json }}, "url": {{ request.origin | json }} }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.article.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "t:sections.article.header_group"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.article.show_author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "t:sections.article.show_read_time",
      "default": true
    },
    {
      "type": "text",
      "id": "read_time_label",
      "label": "t:sections.article.read_time_label",
      "default": "min read"
    },
    {
      "type": "range",
      "id": "words_per_minute",
      "min": 150,
      "max": 300,
      "step": 10,
      "label": "t:sections.article.words_per_minute",
      "default": 220
    },
    {
      "type": "text",
      "id": "kicker_divider",
      "label": "t:sections.article.kicker_divider",
      "default": "·"
    },
    {
      "type": "text",
      "id": "image_aspect",
      "label": "t:sections.article.image_aspect",
      "info": "t:sections.hero.image_aspect_info",
      "default": "16 / 9"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "t:sections.article.back_label",
      "default": "All guides"
    },
    {
      "type": "header",
      "content": "t:sections.article.toc_group"
    },
    {
      "type": "checkbox",
      "id": "show_toc",
      "label": "t:sections.article.show_toc",
      "default": true
    },
    {
      "type": "text",
      "id": "toc_label",
      "label": "t:sections.article.toc_label",
      "default": "In this guide"
    },
    {
      "type": "range",
      "id": "toc_min",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.article.toc_min",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.article.faq_group"
    },
    {
      "type": "paragraph",
      "content": "t:sections.article.faq_info"
    },
    {
      "type": "checkbox",
      "id": "lift_faq",
      "label": "t:sections.article.lift_faq",
      "default": true
    },
    {
      "type": "text",
      "id": "faq_toc_label",
      "label": "t:sections.article.faq_toc_label",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "emit_article_schema",
      "label": "t:sections.article.emit_article_schema",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.article.route_group"
    },
    {
      "type": "paragraph",
      "content": "t:sections.article.route_info"
    },
    {
      "type": "text",
      "id": "route_eyebrow",
      "label": "t:common.eyebrow",
      "default": "Made for this"
    },
    {
      "type": "textarea",
      "id": "route_missing_note",
      "label": "t:sections.article.route_missing_note",
      "default": "This article carries no activity tag, so it routes nowhere. Tag it with one of the activity tags set up on this section before publishing."
    }
  ],
  "blocks": [
    {
      "type": "activity_link",
      "name": "t:sections.article.block_activity_link",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.article.block_activity_link_info"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "t:sections.article.route_tag",
          "info": "t:sections.article.route_tag_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:common.link"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "t:sections.article.route_note"
        }
      ]
    }
  ]
}
{% endschema %}
