{%- comment -%} Blog listing. {%- endcomment -%}
<section class="hs-scheme-{{ section.settings.color_scheme }}">
  <div class="hs-shell hs-pace-base">
    <header class="hs-page__head">
      <h1 class="hs-h2 hs-balance hs-page__title">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by section.settings.per_page -%}
      <ul class="hs-grid hs-stagger" role="list">
        {%- for article in blog.articles -%}
          <li class="hs-reveal">
            <a class="hs-card hs-zoom-parent" href="{{ article.url }}">
              {%- if article.image -%}
                {% render 'hs-image', image: article.image, alt: article.title, aspect: '3 / 2',
                   eager: forloop.first, sizes: '(min-width: 64rem) 30vw, 100vw',
                   wrapper_class: 'hs-card__media hs-media--zoom' %}
              {%- endif -%}
              <div class="hs-card__body">
                <p class="hs-eyebrow">{{ article.published_at | date: format: 'date' }}</p>
                <h2 class="hs-h4 hs-card__title">{{ article.title }}</h2>
                {%- if article.excerpt_or_content != blank -%}
                  <p class="hs-small-body hs-muted hs-pretty">
                    {{ article.excerpt_or_content | strip_html | truncate: 120 }}
                  </p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'hs-pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.blog.name",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ], "default": "paper" },
    { "type": "range", "id": "per_page", "min": 3, "max": 24, "step": 3,
      "label": "t:sections.collection.per_page", "default": 9 }
  ]
}
{% endschema %}
