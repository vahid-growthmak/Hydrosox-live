{%- comment -%}
  Cart.

  Server-rendered end to end — no script touches money. Each line owns its
  own small form posting to /cart/change with a − and a + button, so a
  quantity change applies the moment it is tapped and there is no Update
  button to forget; − on a quantity of one posts zero, which removes the
  line. The summary stands as a sticky aside on the right with the one
  action that matters — checkout — as a plain link to the platform's
  checkout. Both were the client's instruction (2026-08-07): summary and
  checkout on the right, steppers instead of a bare field and Remove link.
{%- endcomment -%}
<section class="hs-scheme-{{ section.settings.color_scheme }}">
  <div class="hs-shell hs-pace-base">
    <header class="hs-page__head">
      <h1 class="hs-h2 hs-balance hs-page__title">{{ 'cart.general.title' | t }}</h1>
    </header>

    {% render 'hs-cart-progress' %}

    {%- if cart.item_count > 0 -%}
      <div class="hs-cart__layout">
        <ul class="hs-cart__list" role="list">
          {%- for item in cart.items -%}
            <li class="hs-cart__item">
              <a class="hs-cart__item-media" href="{{ item.url }}">
                {% render 'hs-image', image: item.image, alt: item.product.title,
                   aspect: '1 / 1', sizes: '96px', wrapper_class: 'hs-cart__thumb' %}
              </a>
              <div class="hs-cart__item-body">
                <a class="hs-small-body hs-cart__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="hs-caption hs-muted">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  {%- for allocation in item.line_level_discount_allocations -%}
                    <p class="hs-caption hs-cart__discount">
                      {{ allocation.discount_application.title }}
                      (&minus;{{ allocation.amount | money }})
                    </p>
                  {%- endfor -%}
                {%- endif -%}
                {%- comment -%}
                  One form per line, two submit buttons: the button that is
                  pressed supplies `quantity`. No JavaScript anywhere in the
                  path — the platform applies the change and re-renders.
                {%- endcomment -%}
                <form action="{{ routes.cart_change_url }}" method="post" class="hs-cart__stepper">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <button
                    class="hs-tap hs-cart__step"
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity | minus: 1 }}"
                    aria-label="{{ 'cart.general.decrease' | t: title: item.product.title }}"
                  >&minus;</button>
                  <span class="hs-small-body hs-tnum hs-cart__qty-value">{{ item.quantity }}</span>
                  <button
                    class="hs-tap hs-cart__step"
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity | plus: 1 }}"
                    aria-label="{{ 'cart.general.increase' | t: title: item.product.title }}"
                  >+</button>
                </form>
              </div>
              <p class="hs-small-body hs-tnum hs-cart__item-total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>

        <aside class="hs-cart__aside">
          <div class="hs-cart__summary">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <p class="hs-caption hs-cart__discount">
                  {{ discount.title }} (&minus;{{ discount.total_allocated_amount | money }})
                </p>
              {%- endfor -%}
            {%- endif -%}
            <p class="hs-h4 hs-tnum hs-cart__subtotal">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </p>
            <p class="hs-caption hs-muted">{{ 'cart.general.taxes_and_shipping' | t }}</p>
            {%- if settings.delivery_estimate != blank -%}
              <p class="hs-caption hs-cartd__eta">
                {% render 'hs-icon', icon: 'check', size: 14 %}
                {{ settings.delivery_estimate }}
              </p>
            {%- endif -%}
            {%- assign checkout_label = 'cart.general.checkout' | t -%}
            {% render 'hs-button', label: checkout_label, href: '/checkout',
               style: 'primary', full: true %}
          </div>
        </aside>
      </div>
    {%- else -%}
      <p class="hs-body hs-muted">{{ 'cart.general.empty' | t }}</p>
      {%- assign keep_shopping = 'general.continue_shopping' | t -%}
      {% render 'hs-button', label: keep_shopping, href: routes.root_url, style: 'primary' %}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.cart.name",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ], "default": "paper" }
  ]
}
{% endschema %}
