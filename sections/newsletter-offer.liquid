{%- comment -%}
  Newsletter offer.

  Copy on the left, a pill email field and ink pill button on the right. Uses
  Shopify's own customer form, so a submission creates a real marketing
  contact and the success and error states come back from the platform.
{%- endcomment -%}

<section
  class="hs-signup hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-signup__pad">
    <div class="hs-signup__grid">
      <div class="hs-signup__lead">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hs-h3 hs-signup__heading hs-measure-18 hs-balance">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="hs-small-body hs-signup__body hs-measure-42 hs-pretty hs-muted">
            {{ section.settings.body }}
          </div>
        {%- endif -%}
      </div>

      <div class="hs-signup__form-col">
        {%- liquid
          # Translate only the fallback. Piping the merchant's own wording
          # through `t` would look it up as a translation key and lose it.
          assign field_label = section.settings.field_label
          if field_label == blank
            assign field_label = 'general.newsletter.email' | t
          endif
        -%}
        {%- form 'customer', id: 'hs-signup-form', class: 'hs-signup__form' -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.tag | escape }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">

          <div class="hs-signup__field-row">
            <label class="hs-visually-hidden" for="hs-signup-email-{{ section.id }}">
              {{ field_label }}
            </label>
            <input
              class="hs-signup__input hs-small-body"
              id="hs-signup-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ field_label | escape }}"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="hs-signup-error-{{ section.id }}"
              {% endif %}
            >
            <button class="hs-signup__submit hs-small-body" type="submit">
              {{ section.settings.submit_label }}
            </button>
          </div>

          {%- if form.errors -%}
            <p class="hs-form-error hs-signup__message" id="hs-signup-error-{{ section.id }}" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p class="hs-form-success hs-signup__message" role="status">
              {%- comment -%}
                Printed, not translated. `default` resolves before `t`, so a
                filled-in success message was being looked up as a translation
                key — every successful signup showed "Translation missing".
              {%- endcomment -%}
              {%- if section.settings.success_message != blank -%}
                {{ section.settings.success_message }}
              {%- else -%}
                {{ 'general.newsletter.success' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if section.settings.note != blank -%}
            <div class="hs-caption hs-signup__note hs-measure-52 hs-pretty hs-muted">
              {{ section.settings.note }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.signup.name",
  "class": "hs-signup-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "wash"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "£5 off your first pair"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Get the code before the weather turns."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:common.body",
      "default": "<p>Applies to a single pair. The two-pair saving is already built into the price.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.signup.form_group"
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "t:sections.signup.field_label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:sections.signup.submit_label",
      "default": "Send my code"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:sections.signup.success_message",
      "default": "Thanks. Your code is on its way."
    },
    {
      "type": "text",
      "id": "tag",
      "label": "t:sections.signup.tag",
      "info": "t:sections.signup.tag_info",
      "default": "newsletter"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "t:sections.signup.note",
      "default": "<p>One email to set you up, then only when there is something worth sending. Unsubscribe any time. See our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.signup.name"
    }
  ]
}
{% endschema %}
