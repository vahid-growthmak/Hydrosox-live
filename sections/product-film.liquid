{%- comment -%}
  Product film.

  A portrait stage on the left holds one layer per chapter, cross-fading as
  the chapter changes; a small round play control sits over its corner. The
  chapters themselves are full-width rows on the right, each with a numbered
  heading and a progress rule that fills when active.

  Each chapter is a block carrying a poster image and, optionally, a video.
  Until a chapter has a video its poster stands as the still, so the section
  renders exactly as designed while the films are still being produced —
  adding them later is a block setting, not a code change.
{%- endcomment -%}

{%- liquid
  # preload=none is right for a clip that waits to be pressed and wrong for one
  # that plays itself: the element would sit on its poster with nothing fetched
  # and never start.
  assign preload_mode = 'none'
  if section.settings.autoplay
    assign preload_mode = 'metadata'
  endif
  assign chapters = section.blocks | where: 'type', 'chapter'
  assign chapter_count = chapters | size
-%}

{% style %}
  #shopify-section-{{ section.id }} .hs-film__stage {
    background-color: {{ section.settings.stage_background | default: '#0b0b0b' }};
  }
{% endstyle %}

<section
  class="hs-film hs-scheme-{{ section.settings.color_scheme }} hs-border-b hs-anchor"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="hs-shell hs-pace-base">
    {% render 'hs-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      lede: section.settings.lede,
      heading_measure: 'hs-measure-17',
      lede_size: 'body'
    %}

    {%- if chapter_count > 0 -%}
      <hs-film class="hs-film__wrap"
    {% if section.settings.autoplay %}data-autoplay{% endif %}>
        <div class="hs-film__grid">
          {%- comment -%} Portrait stage {%- endcomment -%}
          <div class="hs-film__stage-col">
            <div class="hs-film__stage">
              {%- for block in chapters -%}
                <div
                  class="hs-film__layer{% if forloop.first %} is-active{% endif %}"
                  data-hs-slide="{{ forloop.index0 }}"
                  {% unless forloop.first %}
                    aria-hidden="true"
                  {% endunless %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.video != blank -%}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '800x',
                        muted: true,
                        playsinline: true,
                        loop: true,
                        preload: preload_mode,
                        class: 'hs-film__media'
                    }}
                  {%- elsif block.settings.video_fallback != blank -%}
                    {%- comment -%}
                      A clip bundled with the theme, for footage that exists
                      before anyone has uploaded it through the admin. Same
                      element the picker path produces, so the play control and
                      the chapter cross-fade drive it identically. preload=none:
                      nothing is fetched until the visitor presses play.
                    {%- endcomment -%}
                    <video
                      class="hs-film__media"
                      muted
                      playsinline
                      preload="{{ preload_mode }}"
                      loop
                      width="576"
                      height="1024"
                      {% if block.settings.poster_fallback != blank %}
                        poster="{{ block.settings.poster_fallback | asset_url }}"
                      {% endif %}
                    >
                      <source src="{{ block.settings.video_fallback | asset_url }}" type="video/mp4">
                    </video>
                  {%- elsif block.settings.poster != blank -%}
                    <img
                      src="{{ block.settings.poster | image_url: width: 800 }}"
                      srcset="
                        {{ block.settings.poster | image_url: width: 480 }} 480w,
                        {{ block.settings.poster | image_url: width: 800 }} 800w
                      "
                      sizes="(min-width: 64rem) 22rem, 100vw"
                      alt="{{ block.settings.poster_alt | escape }}"
                      width="{{ block.settings.poster.width }}"
                      height="{{ block.settings.poster.height }}"
                      loading="lazy"
                      decoding="async"
                      class="hs-film__media"
                    >
                  {%- elsif block.settings.poster_fallback != blank -%}
                    {%- comment -%}
                      Intrinsic size of the bundled portrait posters. The stage
                      is sized by CSS; these only stop the browser guessing.
                    {%- endcomment -%}
                    <img
                      src="{{ block.settings.poster_fallback | asset_url }}"
                      alt="{{ block.settings.poster_alt | escape }}"
                      width="576"
                      height="1024"
                      loading="lazy"
                      decoding="async"
                      class="hs-film__media"
                    >
                  {%- endif -%}
                </div>
              {%- endfor -%}

              {%- if section.settings.play_label != blank -%}
                <button class="hs-tap hs-film__play" type="button" data-hs-film-play>
                  {% render 'hs-icon', icon: 'play', size: 16, class: 'hs-film__play-icon' %}
                  <span class="hs-visually-hidden">{{ section.settings.play_label }}</span>
                </button>
              {%- endif -%}
            </div>

            {%- if section.settings.stage_caption != blank -%}
              <p class="hs-visually-hidden">{{ section.settings.stage_caption }}</p>
            {%- endif -%}
          </div>

          {%- comment -%} Chapter rows {%- endcomment -%}
          <ol class="hs-film__chapters" role="list">
            {%- for block in chapters -%}
              <li>
                <button
                  class="hs-film__chapter{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-hs-chapter="{{ forloop.index0 }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  <span class="hs-film__chapter-row">
                    {% render 'hs-index-number', index: forloop.index0, size: 'h4', class: 'hs-film__chapter-index' %}
                    <span class="hs-film__chapter-main">
                      <span class="hs-h4 hs-film__chapter-title hs-pretty">{{ block.settings.title }}</span>
                      {%- if block.settings.caption != blank -%}
                        <span class="hs-small-body hs-film__chapter-caption hs-measure-44 hs-pretty">
                          {{- block.settings.caption -}}
                        </span>
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="hs-film__chapter-bar" aria-hidden="true"></span>
                </button>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </hs-film>

      <script src="{{ 'hs-film.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      assign film_links = section.blocks | where: 'type', 'link'
      assign film_link_count = film_links | size
    -%}
    {%- if film_link_count > 0 -%}
      <div class="hs-film__foot">
        {%- for block in film_links -%}
          <a
            class="hs-tap hs-small-body hs-film__foot-link"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label -}}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.film.name",
  "class": "hs-film-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "ink", "label": "t:common.scheme_ink" },
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" }
      ],
      "default": "ink"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.film.autoplay",
      "info": "t:sections.film.autoplay_info",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:common.anchor_id",
      "info": "t:common.anchor_id_info",
      "default": "in-the-wet"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "The product film"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "The sock, in the weather it is for."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "t:common.lede",
      "default": "<p>This is our own film rather than an independent test, so take it for what it is — the product in the conditions it is sold for. <strong>The claim underneath it is checkable</strong>, and that is the membrane, not the footage.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.film.stage_group"
    },
    {
      "type": "color",
      "id": "stage_background",
      "label": "t:sections.film.stage_background",
      "default": "#0b0b0b"
    },
    {
      "type": "textarea",
      "id": "stage_caption",
      "label": "t:sections.film.stage_caption",
      "info": "t:sections.film.stage_caption_info",
      "default": "Four HydroSox colourways — black, white, black with navy and black with grey — pegged to a washing line against a blue ground, with water thrown across them."
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "t:sections.film.play_label",
      "default": "Play the clip"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:sections.film.block_chapter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:common.title",
          "default": "Water thrown at the line"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "t:sections.film.chapter_caption"
        },
        {
          "type": "text",
          "id": "video_fallback",
          "label": "t:sections.film.video_fallback",
          "info": "t:sections.film.video_fallback_info"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.film.video",
          "info": "t:sections.film.video_info"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "t:sections.film.poster",
          "info": "t:sections.film.poster_info"
        },
        {
          "type": "text",
          "id": "poster_alt",
          "label": "t:common.image_alt"
        },
        {
          "type": "text",
          "id": "poster_fallback",
          "label": "t:sections.film.poster_fallback",
          "info": "t:sections.film.poster_fallback_info"
        }
      ]
    },
    {
      "type": "link",
      "name": "t:sections.film.block_link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:common.label",
          "default": "The membrane it is all resting on"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:common.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.film.name",
      "blocks": [
        {
          "type": "chapter",
          "settings": {
            "title": "Water thrown at the line",
            "caption": "All four colourways on a washing line, hit at once.",
            "poster_fallback": "wet-four-colourways.webp"
          }
        },
        {
          "type": "chapter",
          "settings": {
            "title": "Rain on a city street",
            "caption": "Kerb spray and standing water, then the knit face in close-up.",
            "poster_fallback": "wet-city-rain.webp"
          }
        },
        {
          "type": "chapter",
          "settings": {
            "title": "Straight through the puddle",
            "caption": "Road and trail, at running pace, taking the wet line.",
            "poster_fallback": "wet-running.webp"
          }
        },
        {
          "type": "chapter",
          "settings": {
            "title": "Wet road, then mud",
            "caption": "The unglamorous half — churned ground and a soaked verge.",
            "poster_fallback": "wet-road-and-mud.webp"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "The membrane it is all resting on",
            "link": "/#construction"
          }
        }
      ]
    }
  ]
}
{% endschema %}
