{%- comment -%}
  Last-resort destination for this section's calls to action.

  Several sections ship a default CTA label with no default URL, so a template
  that never set one renders `hs-button` without an href — and that is a real
  <button> that looks completely normal and does nothing when clicked. Neither
  theme check nor the settings validator looks at a label and its URL together,
  so it stays invisible until someone taps it.

  Falling back to the product named in theme settings means the worst case is a
  link to the thing being sold rather than a dead control. A URL set on the
  section still wins, and templates set `#buy` where the page has the widget.
{%- endcomment -%}
{%- assign hs_cta_fallback = all_products[settings.schema_product].url | default: routes.all_products_collection_url -%}
{%- assign hs_cta_href = section.settings.cta_link | default: hs_cta_fallback -%}
{%- comment -%}
  Sticky buy bar.

  Slides up once the visitor has scrolled past the hero, and gets out of the
  way whenever the real buy widget is on screen so the page never shows two
  competing calls to action.
{%- endcomment -%}

{%- liquid
  # The bar rides in the footer group, so it is on every page. `product_only`
  # confines it to the product template — the client's call (2026-08-07):
  # everywhere else it shadowed the page's own closing CTA.
  assign show_bar = section.settings.enabled
  if section.settings.product_only and template.name != 'product'
    assign show_bar = false
  endif
-%}
{%- if show_bar and section.settings.cta_label != blank -%}
  {%- liquid
    # The page's own product first on a product template — the bar has to sell
    # what the visitor is looking at, not whatever was pinned in the editor.
    assign bar_product = product
    if section.settings.product != blank
      assign bar_product = all_products[section.settings.product]
    endif
    assign title = section.settings.title
    if title == blank and bar_product != blank
      assign title = bar_product.title
    endif
  -%}

  {% style %}
    #shopify-section-{{ section.id }} .hs-buybar {
      --hs-bar-bg: {{ settings.color_paper | color_modify: 'alpha', 0.95 }};
    }

    #shopify-section-{{ section.id }} .hs-buybar-spacer {
      background-color: {{ settings.color_ink }};
    }
  {% endstyle %}

  {%- comment -%} Keeps the last of the page clear of the fixed bar. {%- endcomment -%}
  <div class="hs-buybar-spacer" aria-hidden="true"></div>

  <hs-buybar
    class="hs-buybar hs-scheme-{{ section.settings.color_scheme }}"
    data-show-after="{{ section.settings.show_after }}"
    data-hide-near="{{ section.settings.hide_near_selector }}"
    {{ section.shopify_attributes }}
  >
    <div class="hs-buybar__inner">
      <p class="hs-buybar__copy">
        {%- if title != blank -%}
          <span class="hs-buybar__title hs-small-body">{{ title }}</span>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <span class="hs-buybar__note hs-caption hs-pretty">{{ section.settings.note }}</span>
        {%- endif -%}
      </p>

      {%- comment -%}
        On a product page the bar carries the real controls, not a link that
        scrolls back to them: the whole point of it appearing is that the buy
        block is off screen. Add to cart posts the variant the widget currently
        has selected — hs-buybar.js mirrors it — and the payment button is
        Shopify's own dynamic checkout, so "buy" means buy rather than "scroll".

        Anywhere without a product, or with the widget missing, it falls back to
        the single link it always was.
      {%- endcomment -%}
      {%- if bar_product != blank and bar_product.available -%}
        {%- assign bar_variant = bar_product.selected_or_first_available_variant -%}
        {% form 'product', bar_product, id: 'hs-buybar-form', class: 'hs-buybar__form', novalidate: 'novalidate' %}
          <input type="hidden" name="id" value="{{ bar_variant.id }}" data-hs-bar-variant>
          <input type="hidden" name="quantity" value="1" data-hs-bar-quantity>

          <button class="hs-btn hs-btn--ink hs-buybar__add" type="submit" name="add" data-hs-bar-add>
            {{- section.settings.add_label | default: 'Add to cart' -}}
          </button>

          {%- comment -%}
            Straight to checkout, skipping the cart. A Shopify cart permalink
            (/cart/variant:quantity) builds a checkout from exactly what is in
            the URL, which is what "buy now" should mean. The dynamic payment
            button that used to sit here showed the wallet's own branding —
            "Buy with shop" — and opened a wallet sheet; the client wants the
            checkout page. hs-buybar.js keeps the href on the variant and
            quantity the widget currently holds.
          {%- endcomment -%}
          <a
            class="hs-btn hs-btn--primary hs-buybar__buy"
            href="{{ routes.cart_url }}/{{ bar_variant.id }}:1"
            data-hs-bar-buy
          >
            {{- section.settings.buy_now_label | default: 'Buy now' -}}
          </a>
        {% endform %}
      {%- else -%}
        {% render 'hs-button',
          label: section.settings.cta_label,
          href: hs_cta_href,
          style: 'primary',
          class: 'hs-buybar__cta'
        %}
      {%- endif -%}
    </div>
  </hs-buybar>

  <script src="{{ 'hs-buybar.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.buybar.name",
  "class": "hs-buybar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:sections.buybar.enabled",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "product_only",
      "label": "t:sections.buybar.product_only",
      "info": "t:sections.buybar.product_only_info",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "paper", "label": "t:common.scheme_paper" },
        { "value": "wash", "label": "t:common.scheme_wash" },
        { "value": "ink", "label": "t:common.scheme_ink" }
      ],
      "default": "paper"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:common.product",
      "info": "t:sections.buybar.product_info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:common.title",
      "info": "t:sections.buybar.title_info"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.buybar.note",
      "default": "Free UK delivery on two pairs or more"
    },
    {
      "type": "header",
      "content": "t:sections.buybar.cta_group"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "t:sections.buybar.buy_now_label",
      "info": "t:sections.buybar.buy_now_label_info",
      "default": "Buy now"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "t:sections.buybar.add_label",
      "info": "t:sections.buybar.add_label_info",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:common.button_label",
      "info": "t:sections.buybar.cta_label_info",
      "default": "Buy a pair"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:common.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.buybar.behaviour_group"
    },
    {
      "type": "range",
      "id": "show_after",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "t:sections.buybar.show_after",
      "info": "t:sections.buybar.show_after_info",
      "default": 80
    },
    {
      "type": "text",
      "id": "hide_near_selector",
      "label": "t:sections.buybar.hide_near",
      "info": "t:sections.buybar.hide_near_info",
      "default": "#buy"
    }
  ]
}
{% endschema %}
