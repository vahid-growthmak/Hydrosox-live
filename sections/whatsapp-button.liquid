{%- comment -%}
  Floating WhatsApp button.

  Sits in the bottom-right corner on every page and opens a chat with the
  number already filled in, carrying a message the visitor can send or edit.
  wa.me wants the number as digits with the country code and no plus or
  spaces, which is why the value is stripped rather than printed.

  The number falls back to the one the footer already publishes, so there is a
  single place to change it. Renders nothing without a number — an empty
  bubble that opens WhatsApp with no recipient is worse than no bubble.
{%- endcomment -%}

{%- liquid
  assign number = section.settings.number | default: settings.whatsapp_number
  assign digits = number | replace: ' ', '' | replace: '+', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  assign show = false
  if section.settings.enabled and digits != blank
    assign show = true
  endif
-%}

{%- if show -%}
  {%- liquid
    assign href = 'https://wa.me/' | append: digits
    if section.settings.message != blank
      assign href = href | append: '?text=' | append: section.settings.message | url_encode
    endif
  -%}
  <a
    class="hs-wa"
    href="{{ href }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.aria_label | default: 'Message us on WhatsApp' | escape }}"
    {{ section.shopify_attributes }}
  >
    {%- comment -%}
      The mark is inline rather than an image file: it has to sit on a coloured
      disc at any size and it must not wait on a second request to appear.
    {%- endcomment -%}
    <svg class="hs-wa__glyph" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
      />
    </svg>
    {%- if section.settings.label != blank -%}
      <span class="hs-wa__label hs-caption">{{ section.settings.label }}</span>
    {%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.whatsapp.name",
  "class": "hs-wa-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:sections.whatsapp.enabled",
      "default": true
    },
    {
      "type": "text",
      "id": "number",
      "label": "t:sections.whatsapp.number",
      "info": "t:sections.whatsapp.number_info"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "t:sections.whatsapp.message",
      "info": "t:sections.whatsapp.message_info",
      "default": "Hi HydroSox — I have a question about your waterproof socks."
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.whatsapp.label",
      "info": "t:sections.whatsapp.label_info"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.whatsapp.aria_label",
      "default": "Message us on WhatsApp"
    }
  ]
}
{% endschema %}
