{%- comment -%}
  WebSite structured data with a SearchAction, homepage only — one site, one
  WebSite node. The search target is the storefront's real search route, so the
  sitelinks search box lands on a page that actually performs the search.
{%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "{{ shop.url }}/#website",
    "url": "{{ shop.url }}/",
    "name": {{ shop.name | json }},
    "inLanguage": "en-GB",
    "publisher": { "@id": "{{ shop.url }}/#organization" },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
</script>
