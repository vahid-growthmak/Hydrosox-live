{%- comment -%}
  Social account links. Renders only the accounts filled in under theme
  settings, so an empty setting leaves no stray icon.

  Accepts:
  - class: {String} Extra classes for the wrapper. Optional.

  Usage:
  {% render 'hs-social' %}
{%- endcomment -%}
{%- liquid
  assign accounts = ''
  if settings.social_instagram != blank
    assign accounts = accounts | append: 'instagram,'
  endif
  if settings.social_facebook != blank
    assign accounts = accounts | append: 'facebook,'
  endif
  if settings.social_tiktok != blank
    assign accounts = accounts | append: 'tiktok,'
  endif
  if settings.social_youtube != blank
    assign accounts = accounts | append: 'youtube,'
  endif
  if settings.social_linkedin != blank
    assign accounts = accounts | append: 'linkedin,'
  endif
  assign account_list = accounts | split: ','
-%}
{%- if account_list.size > 0 -%}
  <ul class="hs-footer__social {{ class }}" role="list">
    {%- for name in account_list -%}
      {%- liquid
        case name
          when 'instagram'
            assign url = settings.social_instagram
            assign label = 'Instagram'
          when 'facebook'
            assign url = settings.social_facebook
            assign label = 'Facebook'
          when 'tiktok'
            assign url = settings.social_tiktok
            assign label = 'TikTok'
          when 'youtube'
            assign url = settings.social_youtube
            assign label = 'YouTube'
          when 'linkedin'
            assign url = settings.social_linkedin
            assign label = 'LinkedIn'
        endcase
      -%}
      <li>
        <a
          class="hs-header__icon-btn"
          href="{{ url }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ label }}"
        >
          <svg
            class="hs-header__icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- case name -%}
              {%- when 'instagram' -%}
                <path
                  d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122s-.01 3.056-.06 4.122c-.05 1.065-.218 1.79-.465 2.428a4.9 4.9 0 0 1-1.153 1.772 4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06s-3.056-.01-4.122-.06c-1.065-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.772-1.153 4.9 4.9 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12s.01-3.056.06-4.122c.05-1.066.217-1.79.465-2.428A4.9 4.9 0 0 1 3.678 3.678 4.9 4.9 0 0 1 5.45 2.525c.638-.248 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm6.5-.25a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0ZM12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"
                />
              {%- when 'facebook' -%}
                <path
                  d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"
                />
              {%- when 'tiktok' -%}
                <path
                  d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.84-2.48V9.78a5.68 5.68 0 1 0 4.93 5.63V8.9a7.35 7.35 0 0 0 4.3 1.38V7.19a4.29 4.29 0 0 1-3.24-1.37Z"
                />
              {%- when 'youtube' -%}
                <path
                  d="M21.58 7.19a2.51 2.51 0 0 0-1.77-1.78C18.25 5 12 5 12 5s-6.25 0-7.81.41A2.51 2.51 0 0 0 2.42 7.2C2 8.75 2 12 2 12s0 3.25.42 4.81a2.51 2.51 0 0 0 1.77 1.78C5.75 19 12 19 12 19s6.25 0 7.81-.41a2.51 2.51 0 0 0 1.77-1.78C22 15.25 22 12 22 12s0-3.25-.42-4.81ZM10 15.5v-7l6 3.5-6 3.5Z"
                />
              {%- when 'linkedin' -%}
                <path
                  d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
                />
            {%- endcase -%}
          </svg>
        </a>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
