<section class="hs-scheme-paper">
  <div class="hs-shell hs-pace-base hs-auth">
    <h1 class="hs-h2 hs-balance hs-page__title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'hs-auth__form' -%}
      {%- if form.errors -%}
        <p class="hs-form-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label class="hs-eyebrow hs-muted" for="hs-reg-first">{{ 'customer.register.first_name' | t }}</label>
      <input class="hs-field" id="hs-reg-first" type="text" name="customer[first_name]" autocomplete="given-name">
      <label class="hs-eyebrow hs-muted" for="hs-reg-last">{{ 'customer.register.last_name' | t }}</label>
      <input class="hs-field" id="hs-reg-last" type="text" name="customer[last_name]" autocomplete="family-name">
      <label class="hs-eyebrow hs-muted" for="hs-reg-email">{{ 'customer.register.email' | t }}</label>
      <input class="hs-field" id="hs-reg-email" type="email" name="customer[email]" autocomplete="email" required>
      <label class="hs-eyebrow hs-muted" for="hs-reg-password">{{ 'customer.register.password' | t }}</label>
      <input class="hs-field" id="hs-reg-password" type="password" name="customer[password]" autocomplete="new-password">
      {% render 'hs-button', label: 'customer.register.submit' | t, style: 'primary', type: 'submit', full: true %}
    {%- endform -%}
  </div>
</section>
