          "settings": {
            "heading": "Waterproof layer",
            "role": "The waterproof barrier",
            "body": "<p>A Porelle® membrane, sealed in the middle. Made by a separate company, so you can look it up. Water can’t get through it. Sweat can get out.</p>",
            "image_alt": "",
            "tint": "#0093ff"
          }
