    "limits": {
      "type": "honest-limits",
      "blocks": {
        "m1": {
          "type": "limit",
          "settings": {
            "heading": "They won’t replace your boots.",
            "body": "<p>If your footwear is wrong for the ground, socks won’t fix it. These keep your feet dry. They don’t add grip or ankle support.</p>",
            "image_fallback": "",
            "image_alt": "",
            "width": "1",
            "tone": "wash",
            "side_by_side": false
          }
        },
        "m2": {
          "type": "limit",
          "settings": {
            "heading": "Water can get in over the top.",
            "body": "<p>A sock is open at the top. Step into water deeper than the sock and it fills up, the same as any sock would.</p>",
            "image_fallback": "",
            "image_alt": "",
            "width": "1",
            "tone": "wash",
            "side_by_side": false
          }
        },
        "m3": {
          "type": "limit",
          "settings": {
            "heading": "They won’t last forever.",
            "body": "<p>Toenails, sharp stones and a tumble dryer will all finish off a waterproof layer. Looked after properly, they last a long time.</p>",
            "image_fallback": "",
            "image_alt": "",
            "width": "2",
            "tone": "blue",
            "side_by_side": false
          }
        },
        "m4": {
          "type": "limit",
          "settings": {
            "heading": "You can still get sweaty feet.",
            "body": "<p>Work hard enough and you’ll sweat faster than the membrane can cope with. It slows it down. It doesn’t stop it.</p>",
            "image_fallback": "",
            "image_alt": "",
            "width": "4",
            "tone": "wash",
            "side_by_side": true
          }
        }
      },
