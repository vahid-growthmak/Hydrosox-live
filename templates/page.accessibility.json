      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "title": "Keyboard and focus",
            "body": "<p>Every control can be reached and operated with a keyboard, focus is always visible, and the menu and cart return focus to where you left it when they close. There is a skip link to the main content.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Text and zoom",
            "body": "<p>Type is set in relative units, so the site follows your browser's text size and reflows to 400% zoom without content being lost or needing sideways scrolling.</p>"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Colour and contrast",
            "body": "<p>Body text and controls are checked against the AA contrast threshold. Colour is never the only thing carrying meaning.</p>"
          }
        },
        "i4": {
          "type": "item",
          "settings": {
            "title": "Motion",
            "body": "<p>Scroll-driven animation and the frame sequence stop when your system asks for reduced motion. Nothing on the site moves or autoplays without being asked.</p>"
          }
        },
        "i5": {
          "type": "item",
          "settings": {
            "title": "Structure and images",
            "body": "<p>Headings are ordered rather than chosen for size, tables carry real headers, forms have real labels, and images that carry meaning have text alternatives.</p>"
          }
        }
      },
