    "problem": {
      "type": "content-columns",
      "settings": {
        "color_scheme": "paper",
        "layout": "steps",
        "numbered": false,
        "eyebrow": "The problem",
        "heading": "The boot is doing half the job.",
        "lede": "<p>A safety boot is built to keep water and everything else out. Nothing about it is built to let anything back out again.</p>",
        "mirror": false
      },
      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "title": "Wet from the inside by lunchtime",
            "body": "<p>A foot produces a serious amount of moisture across a ten-hour shift. In a sealed boot most of it stays there, which is why feet are wet on dry days too.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Wet skin, all winter",
            "body": "<p>Skin that stays damp for months softens, splits and stops recovering overnight. That is the actual cost of this, and it is not comfort.</p>"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Rain and standing water on top of that",
            "body": "<p>Sites flood, ditches fill and wellies get overtopped. The boot handles some of it. The rest arrives anyway.</p>"
          }
        }
      },
