          "settings": {
            "title": "Wash cool",
            "body": "<p>A waterproof layer gives up from heat long before it gives up from age. Cool wash, gentle cycle.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Turn them inside out",
            "body": "<p>It puts the outer knit, not the lining, against the drum.</p>"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "No fabric softener",
            "body": "<p>Softener coats the holes the layer breathes through. Once they’re clogged the sock still keeps water out but stops letting sweat out, which is the worst of both.</p>"
          }
        },
        "i4": {
          "type": "item",
          "settings": {
            "title": "No bleach",
            "body": "<p>It attacks the waterproof layer, not just the colour.</p>"
          }
        },
        "i5": {
          "type": "item",
          "settings": {
            "title": "Air dry",
            "body": "<p>Away from a radiator. A waterproof layer doesn’t need heat to dry, and heat is the thing most likely to end it.</p>"
          }
        },
        "i6": {
          "type": "item",
          "settings": {
            "title": "Never tumble dry or iron",
            "body": "<p>Both are heat, straight onto the layer.</p>"
          }
        },
        "i7": {
          "type": "item",
          "settings": {
            "title": "Rinse the grit out first",
            "body": "<p>After a muddy walk or a wet ride, rinse under a cold tap before washing. Fine grit trapped in the knit rubs against the waterproof layer from the inside, and does more damage than the mud.</p>"
