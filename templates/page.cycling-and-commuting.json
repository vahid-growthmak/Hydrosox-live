        "link2_label": "Care & washing",
        "link2_url": "/pages/care-and-washing"
      },
      "blocks": {
        "w1": {
          "type": "item",
          "settings": {
            "title": "Crew height clears a shoe collar",
            "body": "<p>The cuff sits above the top of most cycling and commuting shoes, so the sock's opening is not level with the shoe's.</p>"
          }
        },
        "w2": {
          "type": "item",
          "settings": {
            "title": "A spare pair in the bag is the whole plan",
            "body": "<p>Change at the far end and the ride home starts dry. That is lighter and cheaper than a second pair of shoes.</p>"
          }
        },
        "w3": {
          "type": "item",
          "settings": {
            "title": "Cool wash, air dry",
            "body": "<p>They are back in the rotation the next morning without needing a dryer.</p>"
          }
        }
      },
      "block_order": [
        "w1",
        "w2",
        "w3"
