      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "faq",
        "one_at_a_time": false,
        "emit_schema": true,
        "eyebrow": "Questions",
        "heading": "The things people ask on this page.",
