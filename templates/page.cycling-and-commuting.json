      "blocks": {
        "r1": {
          "type": "criterion",
          "settings": {
            "label": "Where the water gets in",
            "ours_value": "The waterproof line is on your foot, so ankle spray lands outside it rather than inside.",
            "theirs_value": "Sealed over the shoe, open at the ankle — which is where the spray arrives."
          }
        },
        "r2": {
          "type": "criterion",
          "settings": {
            "label": "Wind",
            "ours_value": "They keep your foot warmer but do nothing for the shoe. In properly cold wind that’s a real gap.",
            "theirs_value": "Better. They block windchill across the whole shoe, which matters below about five degrees."
          }
        },
        "r3": {
          "type": "criterion",
          "settings": {
            "label": "The shoe itself",
            "ours_value": "The shoe gets soaked. Your foot doesn’t.",
            "theirs_value": "The shoe stays dry, which is the strongest argument for them on a commute with nowhere to dry anything."
          }
        },
        "r4": {
          "type": "criterion",
          "settings": {
            "label": "Putting them on",
            "ours_value": "You put a sock on.",
            "theirs_value": "Fiddly, especially in the dark with cold hands, and they tear at the heel where the cleat sits."
          }
        },
        "r5": {
          "type": "criterion",
          "settings": {
            "label": "Cost and how long they last",
            "ours_value": "£20, and they fail from heat and washing rather than from cleat abrasion.",
            "theirs_value": "Around £30–£40 and often a one-season item on a daily commute."
          }
        },
        "r6": {
          "type": "criterion",
          "settings": {
            "label": "Both together",
            "ours_value": "Worth it when: properly cold, properly wet, properly long. The most effective and most expensive option.",
            "theirs_value": "Not worth it when: anything milder. You’ll overheat."
          }
        }
