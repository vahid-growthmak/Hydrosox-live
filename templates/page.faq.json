    "product": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "product",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "The product",
        "heading": "What the sock actually is.",
        "cta_link": "#buy",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Can water get in over the top of the sock?",
            "answer": "<p>Yes. A sock is open at the cuff, so water deeper than the cuff will go in, exactly as it would with any sock. No waterproof sock behaves otherwise, and any brand implying it does is overstating.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do waterproof socks work in snow?",
            "answer": "<p>They keep melted snow out well, and they block wind, which is most of what makes feet cold. They are not insulated, though, so in genuinely cold conditions you want them for the dryness rather than for the warmth.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I wear them for swimming, or in the shower?",
            "answer": "<p>They are not designed for immersion. They are built for water arriving from outside during normal use — rain, spray, puddles, wet ground — not for being submerged, and we would rather say so than take the sale.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will they start to smell?",
            "answer": "<p>They are no more prone to it than any sock, provided they are washed and air dried between wears rather than left damp in a bag. A membrane does not cause odour; a wet sock left in a boot overnight does.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Do they stretch out over time?",
            "answer": "<p>They loosen slightly with wear, as knitted socks do. The shaped fit is built to hold longer than a standard sock because it is structural rather than decorative — it is also the property that matters for masah.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Can I wear them without shoes?",
            "answer": "<p>Around the house, yes. But the outer knit is the wear surface, and walking on hard floors or outside without footwear abrades it far faster than a boot does. It is the quickest way to shorten their life.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ]
    },
    "wudu": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "wudu",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Wudu and masah",
        "heading": "The everyday questions.",
        "cta_link": "#buy",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Do I need to wash my feet before putting them on?",
            "answer": "<p>Yes. The sources are consistent that the footwear must be put on after a complete wudu in which the feet were washed. Masah applies from the next wudu onwards, not from the one during which you put them on.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I wear them for Hajj or Umrah?",
            "answer": "<p>Many people buy them for pilgrimage travel, where facilities are shared and there is little chance to dry anything. On the separate question of footwear restrictions in ihram, ask a scholar — that is not a question we should be answering.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can children use them for wudu?",
            "answer": "<p>Our sizes start at UK 3, so they fit older children. On whether and from what age masah applies for a child, ask a scholar rather than a sock company.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What happens if water gets inside them during wudu?",
            "answer": "<p>This is addressed in the sources and it is a point we have deliberately not paraphrased, because it matters and because getting it approximately right is worse than not answering. The masah page carries the reviewed wording.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Are these suitable for use at the mosque?",
            "answer": "<p>There is no reason they would not be. The practical reason people buy them is the places where wudu is harder — offices, sites, airports, universities — rather than a mosque with proper facilities.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Do you sell a separate wudu version?",
            "answer": "<p>No. It is the same sock, the same membrane and the same construction whichever page you buy it from, at the same price. There is no wudu edition and no wudu premium.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ]
    },
    "sizing": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "sizing",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Sizing and fit",
        "heading": "The bands are on the size guide.",
        "cta_link": "#buy",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I measure my foot?",
            "answer": "<p>Stand on a sheet of paper with your heel against a wall, mark the tip of your longest toe, and measure from the wall to the mark. That figure in centimetres is what the size bands are set by, and it is more reliable than your shoe size.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What if I am larger than UK 14?",
            "answer": "<p>We do not currently make a size above XL, which covers UK 12–14. We would rather tell you that plainly than sell you something that will not fit.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do they fit wide feet?",
            "answer": "<p>They are a close, stretchy fit rather than a loose one. If you normally need a wide fitting in shoes, take the larger band — a sock that grips across the width is uncomfortable over a full day and shortens the life of the membrane.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will they slip down?",
            "answer": "<p>They are shaped to stay in place through normal wear rather than working loose over a day. If a pair does slip, it is usually a size too large, which is worth checking against the foot-length bands.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I wear another sock underneath?",
            "answer": "<p>You can, but there is usually no need — the inner knit is designed to sit against the skin. Adding a liner underneath adds bulk, which matters most in cycling shoes and safety boots where there is least room.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
    "care": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "care",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Washing and lifespan",
        "heading": "The full instructions are on the care page.",
        "cta_link": "#buy",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I dry them quickly?",
            "answer": "<p>You cannot, safely. Turn them inside out and air dry at room temperature with air moving around them. Never on a radiator and never in a tumble dryer — direct heat is the single most common way a waterproof sock dies.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I wash them with the rest of my washing?",
            "answer": "<p>Yes, on a cool cycle, provided there is no fabric softener in the load and nothing abrasive like zips or Velcro. Softener is the problem more often than temperature is.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What temperature should I wash them at?",
            "answer": "<p>Cool, on a gentle cycle. The membrane is a laminate, and heat is what breaks laminates down.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How do I get mud off them?",
            "answer": "<p>Rinse under a cold tap first to get the grit out, then wash cool. Grit left in the knit is abrasive against the membrane from the inside, which matters more than the mud does.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Are they still waterproof once they have been punctured?",
            "answer": "<p>No, and it cannot be repaired. A membrane is a continuous barrier — once it is pierced by a toenail, a thorn or a stone, the water goes through and no spray or reproofing treatment will bring it back.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
