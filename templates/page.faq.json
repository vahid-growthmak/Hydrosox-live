    "product": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "product",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "",
        "heading": "The socks",
        "cta_link": "/products/hydrosox-waterproof-socks",
        "help_link": "/pages/contact",
        "cta_label": "Buy a pair"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Can water get in over the top?",
            "answer": "<p>Yes. A sock is open at the top, so water deeper than the sock will go in, exactly as it would with any sock. No waterproof sock behaves differently, and anyone implying otherwise is overstating.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Will they start to smell?",
            "answer": "<p>No more than any sock, as long as you wash them and let them air dry between wears rather than leaving them damp in a bag. A waterproof layer doesn’t cause odour. A wet sock left in a boot overnight does.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do they stretch out over time?",
            "answer": "<p>They loosen a little with wear, as knitted socks do. The shaped fit holds longer than a standard sock because it’s built into the knit rather than added on — and it’s also the property that matters for masah.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I wear them around the house without shoes?",
            "answer": "<p>You can, but the outer knit is the wear surface, and walking on hard floors abrades it far faster than a boot does. It’s the quickest way to shorten their life.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Are they any good in hot weather?",
            "answer": "<p>Less so. They keep water out just as well, but in warm air your foot produces sweat faster than the waterproof layer can move it. In a British summer downpour a thin sock is often the better call.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Do you make children’s sizes?",
            "answer": "<p>Not below UK 3, which is where our smallest size starts. It fits older children but not younger ones, and we’d rather say so than sell you something that won’t fit.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ]
    },
