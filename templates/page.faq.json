        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Where do you ship from?",
            "answer": "<p>A UK warehouse, held by a UK company. Nothing on this site is dropshipped from elsewhere and relabelled.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do you ship outside the UK?",
            "answer": "<p>The shipping policy states where we currently deliver. If your country is not listed, ask before ordering rather than assuming — we would rather tell you no than take the money and work it out afterwards.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>No delivery speed is printed anywhere on this site, because we will not promise one that confirmed stock cannot support. When that changes it will be stated as a number of days, not as an adjective.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>A tracking reference goes out when the parcel is despatched, and the track order page takes an order number and an email address.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
    },
    "returns": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "returns",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Returns and faults",
        "heading": "Your rights are the floor, not the ceiling.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long do I have to change my mind?",
            "answer": "<p>Fourteen days from delivery to tell us, and fourteen more to send them back. That is the statutory minimum for a distance sale and we have no interest in being stingier than the law.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do they have to be unworn?",
            "answer": "<p>You may examine them as you would in a shop. Wearing a pair for a week on a hill goes beyond that, and the refund can be reduced accordingly — which is the law's position, not a policy we invented.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "They leaked. What happens?",
            "answer": "<p>That is a faulty product, not a change of mind, and a different set of rights applies: thirty days to reject them outright for a full refund. Tell us what happened and where the water came in.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Who pays for return postage?",
            "answer": "<p>It depends which of the two situations above applies, and the refund policy sets out both. A faulty pair is never at your cost.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
    },
    "company": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "company",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "The company",
        "heading": "Who is behind this.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are you the brand or a reseller?",
            "answer": "<p>The brand. We specify and sell the sock; the membrane inside it is licensed from a third party, which is stated everywhere it is mentioned rather than quietly implied to be ours.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Where are you based?",
            "answer": "<p>A UK registered company at 399–405 Oxford Street, Mayfair, London W1C 2BU. The company section publishes the address, the phone number and the email on every page rather than behind a form.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I speak to an actual person?",
            "answer": "<p>Yes. The phone number and email address are answered by people, and neither is a queue for a ticketing system.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do you sell wholesale or to trade?",
            "answer": "<p>There is no public trade pricing, and there is no form queue for it either. The partner page explains what we can and cannot do at this size.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
