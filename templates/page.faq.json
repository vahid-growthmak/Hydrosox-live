    "sizing": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "sizing",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "",
        "heading": "Sizing and fit",
        "lede": "<p>The size chart itself is on the size guide.</p>",
        "cta_link": "/products/hydrosox-waterproof-socks",
        "help_link": "/pages/contact",
        "cta_label": "Buy a pair"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I measure my foot?",
            "answer": "<p>Stand on a sheet of paper with your heel against a wall, mark where your longest toe ends, and measure from the wall to the mark. That measurement in centimetres is what our sizes are set by, and it’s far more reliable than your shoe size.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What if I’m bigger than UK 14?",
            "answer": "<p>We don’t currently make anything above XL, which covers UK 12 to 14. We’d rather tell you plainly than sell you a pair that won’t fit.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do they fit wide feet?",
            "answer": "<p>They’re a close, stretchy fit rather than a loose one. If you normally need a wide fitting in shoes, take the bigger size — a sock that grips across the width is uncomfortable over a full day and hard on the waterproof layer.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will they slip down?",
            "answer": "<p>They’re shaped to stay in place through a normal day rather than working loose. If a pair does slip, it’s usually a size too big, which is worth checking against the foot-length measurements.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I wear another sock underneath?",
            "answer": "<p>You can, but there’s usually no need — the inner knit is designed to sit against your skin. Adding a liner adds bulk, which matters most in cycling shoes and safety boots where there’s least room.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
    "care": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "care",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "",
        "heading": "Washing and looking after them",
        "lede": "<p>Full instructions are on the care page.</p>",
        "cta_link": "/products/hydrosox-waterproof-socks",
        "help_link": "/pages/contact",
        "cta_label": "Buy a pair"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I dry them quickly?",
            "answer": "<p>You can’t, safely. Turn them inside out and air dry them at room temperature with air moving around them. Never on a radiator and never in a tumble dryer — direct heat is the most common way a waterproof sock dies.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I wash them with the rest of my washing?",
            "answer": "<p>Yes, on a cool cycle, as long as there’s no fabric softener in the load and nothing abrasive like zips or Velcro. Softener causes more problems than temperature does.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What detergent should I use?",
            "answer": "<p>An ordinary liquid detergent is fine. Avoid anything sold as a softening or conditioning detergent, and avoid biological powder left undissolved against the fabric.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How do I get mud off them?",
            "answer": "<p>Rinse under a cold tap first to get the grit out, then wash cool. Grit left in the knit rubs against the waterproof layer from the inside, which does more damage than the mud does.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Are they still waterproof once there’s a hole in them?",
            "answer": "<p>No, and it can’t be repaired. The waterproof layer is a continuous barrier — once it’s pierced by a toenail, a thorn or a stone, water goes through and no spray or treatment brings it back.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
