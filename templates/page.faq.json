    "product": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "product",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "The product",
        "heading": "What the sock actually is.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What is the membrane, and do you make it?",
            "answer": "<p>Porelle® is a third-party waterproof-breathable laminate, licensed rather than invented here. We knit the sock around it. The membrane's own composition is its manufacturer's to publish, and we will not guess at it on their behalf.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Are they really PFOA free?",
            "answer": "<p>That is stated on the product, and it is a claim we carry from the manufacturer rather than one we have tested ourselves. If you need the documentation for a procurement process, ask and we will send what the manufacturer provides.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What height are they?",
            "answer": "<p>Crew height, sitting above the ankle bone. One height only — there is no ankle or knee-length version, and if that changes this page will say so.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Which colours are there?",
            "answer": "<p>Four: plain black, plain white, black with a navy panel, and black with a grey panel. The panel is cosmetic; the construction is identical.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Is there a men's version and a women's version?",
            "answer": "<p>No. One sock, sized on foot length, covering UK 3 to UK 14. Splitting a single product into two listings would tell you nothing that the size bands do not already.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
    "wudu": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "wudu",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Wudu and masah",
        "heading": "Where we stop, and why.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Has any scholar or body approved these socks?",
            "answer": "<p>No. No certificate has been issued, by us or by anyone else. If one is ever issued we will publish it here with the name of whoever issued it, and until then the honest answer is the one above.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Why will you not simply say they are valid for masah?",
            "answer": "<p>Because that is a ruling, and a sock company issuing rulings is not a sock company you should trust. We state the physical properties. Whether those satisfy the conditions is for someone qualified to say.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What are the three properties you keep referring to?",
            "answer": "<p>Waterproof, holding their shape when not worn, and staying on the foot. Those are product facts, stated as product facts. The masah page sets out the conditions the classical positions describe and names its sources.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How long does masah last?",
            "answer": "<p>That is one of the conditions, not a property of the sock, so it is set out on the masah page alongside the positions it comes from rather than answered here as though it were ours to decide.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
    },
    "sizing": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "sizing",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Sizing and fit",
        "heading": "Measured, not guessed.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I measure my foot properly?",
            "answer": "<p>Stand on a sheet of paper with your heel against a wall, mark the end of your longest toe, and measure from the wall to the mark. Do it late in the day, when your foot is at its largest.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "I am between two bands. Which do I take?",
            "answer": "<p>The larger one. These are a close, stretchy fit, and a size down grips the toes and shortens the life of the membrane.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do they come in half sizes?",
            "answer": "<p>No. Four bands cover UK 3 to UK 14, which is why they are published as foot lengths in centimetres rather than as shoe sizes.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will they stretch out over time?",
            "answer": "<p>They relax slightly with wear and recover in the wash. A sock that has gone permanently slack has usually been dried on heat, which damages the elastane as well as the membrane.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "The size is wrong. What now?",
            "answer": "<p>Fourteen days to change your mind, no reason needed and no form to find. The returns policy sets out the mechanics.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
    "care": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "care",
        "one_at_a_time": false,
        "emit_schema": false,
        "eyebrow": "Washing and care",
        "heading": "A membrane dies of heat, not of use.",
        "help_prefix": "Not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Can I put them in the washing machine?",
            "answer": "<p>Yes — a cool wash on a gentle cycle. What ends a membrane is heat and fabric softener rather than the wash itself, so the temperature matters far more than the method.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I tumble dry them?",
            "answer": "<p>No. Heat is the single fastest way to destroy a waterproof membrane, and a tumble dryer applies it for half an hour at a time.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I use fabric softener?",
            "answer": "<p>No. Softener works by coating fibres, and a coated membrane stops passing vapour — so the sock becomes less breathable rather than softer.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How should I dry them?",
            "answer": "<p>Hung up, away from radiators and direct sun. They dry more slowly than an ordinary sock, which is the usual reason people who wear them daily keep three or more pairs.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I iron them or use a steamer?",
            "answer": "<p>No. Both apply exactly the heat the membrane cannot survive, and neither is needed on a knitted sock.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
    "delivery": {
