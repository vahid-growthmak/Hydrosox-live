    "practice": {
      "type": "content-columns",
      "settings": {
        "color_scheme": "paper",
        "layout": "list",
        "numbered": false,
        "eyebrow": "In practice",
        "heading": "Worth knowing before a long day.",
        "link_label": "Size guide",
        "link_url": "/pages/size-guide",
        "link2_label": "Care & washing",
        "link2_url": "/pages/care-and-washing"
      },
      "blocks": {
        "w1": {
          "type": "item",
          "settings": {
            "title": "Wear them like a sock, not a liner",
            "body": "<p>They go next to the skin with nothing underneath. Adding a liner sock fills the space the boot was fitted for.</p>"
          }
        },
        "w2": {
          "type": "item",
          "settings": {
            "title": "Adjust the lacing, not the sock",
            "body": "<p>Three bonded layers sit slightly thicker than a technical merino sock. If a boot is already snug, the lacing is where you find the room.</p>"
          }
        },
        "w3": {
          "type": "item",
          "settings": {
            "title": "They wash normally",
            "body": "<p>A cool machine wash. No fabric conditioner and no tumble dryer — one coats a membrane and the other degrades it.</p>"
          }
        },
        "w-w1": {
          "type": "item",
          "settings": {
            "title": "They are not a winter-only sock",
            "body": "<p>Because the membrane breathes, they are wearable when it is not raining. Plenty of people wear them as their normal sock and stop checking the forecast.</p>"
          }
        },
        "w-w2": {
          "type": "item",
          "settings": {
            "title": "Two pairs is the honest number",
            "body": "<p>One on, one in the wash. Anything beyond that is preference, not requirement.</p>"
          }
        },
        "w-w3": {
          "type": "item",
          "settings": {
            "title": "Cool wash, no conditioner, no dryer",
            "body": "<p>The same care as any technical layer. Fabric conditioner coats a membrane and heat is what finishes one off.</p>"
          }
        }
      },
      "block_order": [
        "w1",
