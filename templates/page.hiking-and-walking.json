    "faq": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "wash",
        "anchor_id": "faq",
        "one_at_a_time": false,
        "emit_schema": true,
        "eyebrow": "Questions",
        "heading": "The things people ask on this page.",
        "help_prefix": "Something not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact",
        "cta_link": "#buy"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are waterproof socks good for hiking?",
            "answer": "<p>Yes, particularly on long days in wet conditions. They keep the foot dry once a boot has wet out, which on British hills is usually a question of when rather than whether. They do not replace a boot's support, grip or ankle protection.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do waterproof socks stop blisters?",
            "answer": "<p>They remove one of the three causes. Wet skin softens and blisters more readily, so keeping the foot dry helps considerably. Friction and poor fit still cause blisters, and no sock fixes a boot that rubs.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can you wear waterproof socks with walking boots?",
            "answer": "<p>Yes, with one check. They sit at roughly the bulk of a mid-weight walking sock, so if your boots are already tight with thick socks they will be tighter with these. They replace a liner-and-sock combination rather than adding to it.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Are waterproof socks better than waterproof boots?",
            "answer": "<p>They solve different halves of the same problem. A boot keeps water out until its outer saturates; a waterproof sock keeps working after that. Most people who walk regularly in the wet end up using both.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "What socks should I wear for hiking in the rain?",
            "answer": "<p>Something that is still doing its job in hour six, not just hour one. That means either a boot that will not wet out in the conditions you are actually in, or a waterproof layer on the foot itself. On a full wet British day, usually the second.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Will my feet get sweaty on a long walk?",
            "answer": "<p>Walking pace is well within what the membrane can move, so most people are dry all day. On a steep sustained climb in mild weather you will out-produce it for a while, then catch up on the descent.</p>"
          }
        }
      },
