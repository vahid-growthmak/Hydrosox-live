    "faq": {
      "type": "faq-accordion",
      "settings": {
        "color_scheme": "wash",
        "anchor_id": "faq",
        "one_at_a_time": false,
        "emit_schema": true,
        "eyebrow": "Questions",
        "heading": "Common questions",
        "help_prefix": "Something not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact",
        "cta_link": "#buy"
