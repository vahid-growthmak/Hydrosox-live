    "ends": {
      "type": "content-columns",
      "settings": {
        "color_scheme": "paper",
        "layout": "split",
        "numbered": false,
        "anchor_id": "what-ends-it",
        "eyebrow": "What ends it",
        "heading": "What ends masah",
        "footnote": "Sources also deal with water getting inside the sock and wetting the foot. Because that’s directly relevant to a waterproof sock, we’ve deliberately left it for the reviewing scholars to word rather than paraphrasing it ourselves."
      },
      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "title": "Anything that breaks wudu",
            "body": "<p>Masah is part of wudu. Whatever breaks the wudu breaks the masah with it, and a fresh wudu is needed.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Taking the socks off",
            "body": "<p>Removing them during the period ends the masah, even if the time hasn’t run out.</p>"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Anything requiring ghusl",
            "body": "<p>Where a full ghusl is required, wiping isn’t enough. The feet are washed.</p>"
          }
        }
      },
