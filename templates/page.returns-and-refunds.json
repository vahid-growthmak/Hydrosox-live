          "settings": {
            "title": "Tell us within 14 days",
            "body": "<p>Fourteen days from the day the parcel arrives. Email or phone us \u2014 a clear statement that you are cancelling is enough, there is no form to find.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Send them back within 14 more",
            "body": "<p>Unworn, in the original packaging, with any seal intact. You may inspect them as you would in a shop.</p>"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Refunded within 14 days of arrival",
            "body": "<p>The price plus the standard outbound delivery charge if you paid one, back to the card you used.</p>"
          }
        }
      },
