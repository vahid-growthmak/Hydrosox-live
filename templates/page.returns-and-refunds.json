      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "title": "Within 30 days, reject and get a full refund",
            "body": "<p>Under the Consumer Rights Act 2015 goods must be of satisfactory quality, fit for purpose and as described.</p>"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "After 30 days, repair or replacement",
            "body": "<p>And a refund or price reduction if that does not resolve it. We do not charge for returning faulty goods.</p>"
          }
        }
      },
