      "type": "faq-accordion",
      "settings": {
        "color_scheme": "paper",
        "anchor_id": "faq",
        "one_at_a_time": false,
        "emit_schema": true,
        "eyebrow": "Questions",
        "heading": "The things people ask on this page.",
        "help_prefix": "Something not here?",
        "help_label": "Phone or email us",
        "help_link": "/pages/contact",
        "cta_link": "#buy"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are waterproof socks good for running?",
            "answer": "<p>In cold, wet conditions, yes — they keep the foot dry and therefore warm on winter miles and on wet trails. In warm rain or on hard efforts in mild weather they are the wrong choice, and this page says which runs those are.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Are waterproof socks too hot for running?",
            "answer": "<p>In summer, generally yes. The membrane moves vapour but it cannot keep up with a running foot in warm, humid air. In British winter conditions the balance goes the other way and they are comfortable for hours.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do waterproof socks feel bulky when running?",
            "answer": "<p>They sit at about the volume of a cushioned training sock. In a normal training shoe that is unremarkable. In a snug race-fit shoe it is noticeable, and we would not recommend them for that.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What socks should I wear for trail running in the rain?",
            "answer": "<p>If it is cold, a waterproof sock — wet feet lose heat quickly and that is what ends winter runs. If it is mild, a thin quick-draining sock and dry socks in the car. The temperature decides, not the rain.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Will waterproof socks stop blisters when running?",
            "answer": "<p>They remove one of the three causes, and at running cadence wet skin is the one that changes fastest. Fit and shoe friction still matter, and we do not offer a blister-free guarantee because those are not ours to control.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "How many pairs do runners usually need?",
            "answer": "<p>Two or three if you run through winter. They air dry rather than tumble dry, so a single pair will not be ready for tomorrow morning after a wet run today.</p>"
          }
        }
      },
      "block_order": [
