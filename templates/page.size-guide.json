    "howto": {
      "type": "content-columns",
      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "title": "How to measure",
            "body": "<p>Stand on a sheet of paper with your heel against a wall, mark the tip of your longest toe, and measure from the wall to the mark. Do it in the afternoon — feet are slightly larger later in the day.</p>",
            "link_label": "",
            "link_url": "",
            "image_fallback": "",
            "image_alt": ""
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Between two sizes",
            "body": "<p>Take the larger one. These are a close, stretchy fit, and a size down grips the toes and shortens the life of the membrane.</p>",
            "link_label": "",
            "link_url": "",
            "image_fallback": "",
            "image_alt": ""
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Measure both feet",
            "body": "<p>Most people have one foot slightly larger than the other. Size to the larger one. It is a small thing and it is the reason a lot of socks feel right on one foot and tight on the other.</p>",
            "link_label": "",
            "link_url": "",
            "image_fallback": "",
            "image_alt": ""
          }
        },
        "i4": {
          "type": "item",
          "settings": {
            "title": "Inside boots and cycling shoes",
            "body": "<p>They sit at roughly the bulk of a mid-weight sock. Snug walking boots and race-fit cycling shoes are where that matters — the use-case pages cover each in more detail.</p>",
            "link_label": "",
            "link_url": "",
            "image_fallback": "",
            "image_alt": ""
          }
        }
