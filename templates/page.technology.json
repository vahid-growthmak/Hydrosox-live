    "intro": {
      "type": "centre-note",
      "settings": {
        "color_scheme": "paper",
        "hide_rule": false,
        "anchor_id": "",
        "max_width": 46,
        "eyebrow": "The technology",
        "heading": "How waterproof socks work",
        "heading_tag": "h1",
        "heading_size": "h2",
        "lead_first_para": false,
        "body": "<p>“Waterproof” is a word anyone can print on a label. This is what’s underneath ours, so you can judge it rather than take our word for it.</p>",
        "footnote": "",
        "pointer_label": "",
        "pointer_link_label": "",
        "pointer_url": "",
        "cta_label": "",
        "cta_url": "",
        "link_label": "",
