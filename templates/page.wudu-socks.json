          "settings": {
            "title": "Wudu at work",
            "body": "<p>Washing your feet in a basin built for hands is awkward, cold and slow — and then you sit in damp socks for the rest of the afternoon.</p>"
          }
        },
        "e2": {
          "type": "item",
          "settings": {
