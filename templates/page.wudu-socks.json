        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "Holds its shape",
            "body": "<p>Structured so it stays a covering over the foot rather than collapsing flat against it. It stands upright when it is not being worn, and you can see that in the photographs on this page.</p>",
            "image_fallback": "colour-black.webp",
            "image_alt": "A pair of black HydroSox standing upright unworn, holding their shape"
