<section class="hs-scheme-ink">
  <div class="hs-shell hs-pace-vast hs-auth">
    <h1 class="hs-h1 hs-balance">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="hs-hero-body hs-measure-46 hs-pretty hs-muted">{{ shop.password_message }}</div>
    {%- endif -%}
    {%- form 'storefront_password', class: 'hs-auth__form' -%}
      {%- if form.errors -%}
        <p class="hs-form-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label class="hs-eyebrow" for="hs-storefront-password">{{ 'customer.login.password' | t }}</label>
      <input class="hs-field" id="hs-storefront-password" type="password" name="password" autocomplete="current-password">
      {% render 'hs-button', label: 'customer.login.submit' | t, style: 'primary', type: 'submit', full: true %}
    {%- endform -%}
  </div>
</section>
